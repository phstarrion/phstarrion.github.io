---
import { activeServices, type ServiceId } from '../lib/services';

interface Props {
  headingId?: string;
  heading?: string;
}

const { headingId = 'service-hub-title', heading = 'Services' } = Astro.props;

/*
 * Marks are drawn in currentColor so they inherit the link colour and never introduce a palette
 * outside DESIGN.md. X ships a monochrome glyph, so it is reproduced faithfully. Suno's only mark
 * is an orange-to-pink gradient roundel containing its own wordmark, which would both fight the
 * warm-paper palette and repeat the label beside it; a neutral waveform stands in for it instead.
 * Every mark is decorative: the visible service name carries the meaning.
 */
const icons: Record<ServiceId, string> = {
  x: '<path d="M13.86 10.47 21.15 2h-1.73l-6.33 7.36L8.03 2H2.2l7.64 11.12L2.2 22h1.73l6.68-7.77L15.95 22h5.83zM11.5 13.22l-.77-1.11L4.55 3.3h2.65l4.97 7.11.78 1.11 6.46 9.24h-2.65z"/>',
  suno: '<rect x="2.5" y="9.5" width="2" height="5" rx="1"/><rect x="7" y="5.5" width="2" height="13" rx="1"/><rect x="11.5" y="2.5" width="2" height="19" rx="1"/><rect x="16" y="6.5" width="2" height="11" rx="1"/><rect x="20.5" y="10" width="2" height="4" rx="1"/>',
  tiktok:
    '<path d="M16.5 2h-3v14a3 3 0 1 1-3-3V10a6 6 0 1 0 6 6V8.6a7 7 0 0 0 4 1.3V6.9a4 4 0 0 1-4-4Z"/>',
};
---

<section class="service-hub" aria-labelledby={headingId}>
  <h2 id={headingId}>{heading}</h2>
  <ul>
    {activeServices.map(({ id, label, url }) => (
      <li>
        <a href={url} rel="me noopener noreferrer" target="_blank" data-service={id}>
          <svg class="service-hub__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons[id]} />
          <span class="service-hub__name">{label}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .service-hub {
    display: grid;
    gap: var(--space-sm);
  }

  h2 {
    color: var(--color-muted);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    line-height: var(--type-label-line-height);
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    align-items: center;
    color: var(--color-kanon-blue);
    display: inline-flex;
    gap: var(--space-sm);
    min-height: 44px;
    text-decoration: none;
  }

  .service-hub__mark {
    fill: currentColor;
    flex: none;
    height: 1.05em;
    width: 1.05em;
  }

  .service-hub__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-kanon-blue-hover);
  }
</style>
