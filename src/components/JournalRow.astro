---
interface Props {
  title: string;
  summary: string;
  category: string;
  publishedAt: Date;
  href: string;
  headingLevel?: 'h2' | 'h3';
}

const { title, summary, category, publishedAt, href, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const date = publishedAt.toISOString().slice(0, 10);
---

<article class="journal-row">
  <div class="journal-row__meta">
    <time datetime={date}>{date.replaceAll('-', '.')}</time>
    <span>{category}</span>
  </div>
  <div>
    <Heading><a href={href}>{title}</a></Heading>
    <p>{summary}</p>
  </div>
</article>

<style>
  .journal-row:first-child { border-top: 0; }

  .journal-row {
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-lg);
  }

  .journal-row__meta {
    color: var(--color-muted);
    display: flex;
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    gap: var(--space-md);
    letter-spacing: var(--type-label-letter-spacing);
    line-height: var(--type-label-line-height);
  }

  h2,
  h3,
  p {
    margin: 0;
  }

  h2,
  h3 {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.4rem);
    font-weight: var(--type-headline-md-weight);
    line-height: var(--type-headline-md-line-height);
  }

  a {
    color: var(--color-ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 180ms ease-out;
  }

  a:hover {
    color: var(--color-kanon-blue-hover);
  }

  p {
    color: var(--color-muted);
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-line-height);
    margin-top: var(--space-sm);
    max-width: var(--reading-max-width);
  }

  @media (min-width: 768px) {
    .journal-row {
      grid-template-columns: minmax(152px, 2fr) minmax(0, 7fr);
    }
  }
</style>
