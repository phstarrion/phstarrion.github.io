---
const filters = [
  { value: 'all', label: 'All' },
  { value: 'music', label: 'Music' },
  { value: 'visual', label: 'Visual' },
  { value: 'video', label: 'Video' },
] as const;

/*
 * The three listening modes. Kawaii and Dark are both fast breakbeat music but land very
 * differently, so a visitor who arrived for one should not be handed the other; Pop carries the
 * songs that are not built on breakbeats.
 */
const styles = [
  { value: 'all', label: 'All' },
  { value: 'kawaii', label: 'Kawaii' },
  { value: 'dark', label: 'Dark' },
  { value: 'pop', label: 'Pop' },
] as const;
---

<div class="work-filters">
  <nav class="work-filters__row" aria-label="作品カテゴリー" data-work-filter-controls>
    {filters.map(({ value, label }) => (
      <button
        class="work-filters__button"
        type="button"
        data-work-filter={value}
        aria-controls="works-list"
        aria-pressed={value === 'all' ? 'true' : 'false'}
      >
        {label}
      </button>
    ))}
  </nav>

  <nav
    class="work-filters__row work-filters__row--styles"
    aria-label="音楽のスタイル"
    data-work-style-controls
    hidden
  >
    <p class="work-filters__legend">Style</p>
    {styles.map(({ value, label }) => (
      <button
        class="work-filters__button"
        type="button"
        data-work-style={value}
        aria-controls="works-list"
        aria-pressed={value === 'all' ? 'true' : 'false'}
      >
        {label}
      </button>
    ))}
  </nav>
</div>

<script is:inline type="module" data-work-filters>
  const validCategories = new Set(['all', 'music', 'visual', 'video']);
  const validStyles = new Set(['all', 'kawaii', 'dark', 'pop']);
  const controls = document.querySelector('[data-work-filter-controls]');
  const styleControls = document.querySelector('[data-work-style-controls]');
  const buttons = controls?.querySelectorAll('[data-work-filter]') ?? [];
  const styleButtons = styleControls?.querySelectorAll('[data-work-style]') ?? [];
  const cards = document.querySelectorAll('[data-category]');

  let category = 'all';
  let style = 'all';

  const render = () => {
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.workFilter === category));
    });
    styleButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.workStyle === style));
    });

    // Styles only describe music, so the row appears with that category and nothing else.
    if (styleControls) styleControls.hidden = category !== 'music';

    cards.forEach((card) => {
      const matchesCategory = category === 'all' || card.dataset.category === category;
      const matchesStyle = style === 'all' || card.dataset.style === style;
      card.hidden = !(matchesCategory && matchesStyle);
    });
  };

  const syncUrl = () => {
    const url = new URL(window.location.href);

    // A style only exists within music, so it carries the category implicitly and the shared URL
    // stays a single parameter.
    if (category === 'music' && style !== 'all') {
      url.searchParams.delete('category');
      url.searchParams.set('style', style);
    } else {
      url.searchParams.delete('style');
      if (category === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', category);
    }

    window.history.replaceState(
      window.history.state,
      '',
      `${url.pathname}${url.search}${url.hash}`,
    );
  };

  const params = new URLSearchParams(window.location.search);
  const requestedCategory = params.get('category') ?? 'all';
  const requestedStyle = params.get('style') ?? 'all';
  category = validCategories.has(requestedCategory) ? requestedCategory : 'all';
  style = validStyles.has(requestedStyle) ? requestedStyle : 'all';
  // A style without its category would silently hide every card outside music.
  if (style !== 'all') category = 'music';
  render();

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const next = button.dataset.workFilter;
      if (!next || !validCategories.has(next)) return;

      category = next;
      if (category !== 'music') style = 'all';
      syncUrl();
      render();
    });
  });

  styleButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const next = button.dataset.workStyle;
      if (!next || !validStyles.has(next)) return;

      style = next;
      syncUrl();
      render();
    });
  });
</script>

<style>
  .work-filters {
    display: grid;
    gap: var(--space-md);
  }

  .work-filters__row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .work-filters__row--styles {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }

  .work-filters__row[hidden] {
    display: none;
  }

  .work-filters__legend {
    color: var(--color-muted);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    line-height: var(--type-label-line-height);
    margin: 0 var(--space-sm) 0 0;
    text-transform: uppercase;
  }

  .work-filters__button {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-ink);
    cursor: pointer;
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    line-height: var(--type-label-line-height);
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    transition:
      background-color 180ms ease-out,
      border-color 180ms ease-out,
      color 180ms ease-out;
  }

  .work-filters__button:hover {
    border-color: var(--color-kanon-blue);
    color: var(--color-kanon-blue-hover);
  }

  .work-filters__button[aria-pressed='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-surface);
  }
</style>
