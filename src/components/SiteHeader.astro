---
const navigation = [
  { href: '/works/', label: 'Works' },
  { href: '/journal/', label: 'Journal' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrentRoute = (href: string) => {
  if (href === '/') return currentPath === '/';

  const routePath = href.replace(/\/+$/, '');
  return currentPath === routePath || currentPath.startsWith(`${routePath}/`);
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a
      class="site-header__brand"
      href="/"
      aria-label="Home — Kanon Studio"
      aria-current={isCurrentRoute('/') ? 'page' : undefined}
    ><span class="site-header__moon" aria-hidden="true">☾</span><span>Kanon Studio<span class="site-header__tagline">Music & little wonders</span></span></a>
    <details class="site-header__menu">
      <summary>メニュー</summary>
      <nav aria-label="メインナビゲーション">
        <ul>
          {navigation.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrentRoute(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { background: var(--color-surface); }
  .site-header__brand { gap: 12px; }
  .site-header__moon { display: grid; place-items: center; width: 35px; height: 35px; border: 1px solid var(--color-border); border-radius: 50%; font-family: serif; font-size: 27px; color: var(--color-primary); }
  .site-header__tagline { display: block; color: var(--color-muted); font-family: var(--font-body); font-size: 9px; font-weight: 400; letter-spacing: .1em; line-height: 1.5; }
  nav { border-radius: 8px; box-shadow: 0 8px 24px #3631440a; }
  @media (min-width: 768px) { nav { box-shadow: none; } }

  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-inline: auto;
    max-width: var(--content-max-width);
    min-height: 76px;
    padding-inline: var(--page-padding);
  }

  .site-header__brand,
  summary,
  nav a {
    align-items: center;
    color: var(--color-ink);
    display: inline-flex;
    min-height: 44px;
    min-width: 44px;
    text-decoration: none;
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: var(--type-headline-md-weight);
    letter-spacing: var(--type-headline-md-letter-spacing);
  }

  .site-header__menu {
    position: relative;
  }

  summary {
    color: var(--color-kanon-blue);
    cursor: pointer;
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '＋';
    font-size: 1rem;
    margin-left: var(--space-xs);
  }

  details[open] summary::after {
    content: '−';
  }

  nav {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    min-width: 180px;
    padding: var(--space-sm) var(--space-md);
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-xs));
    z-index: 1;
  }

  nav ul {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: var(--type-body-sm-size);
  }

  nav a:hover {
    color: var(--color-kanon-blue-hover);
  }

  .site-header a[aria-current='page'] {
    position: relative;
  }

  .site-header a[aria-current='page']::after {
    background: var(--color-coral);
    border-radius: var(--radius-full);
    bottom: 2px;
    content: '';
    height: 4px;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
    width: 4px;
  }

  @media (min-width: 768px) {
    .site-header__menu {
      align-items: center;
      display: flex;
    }

    summary {
      display: none;
    }

    nav {
      background: transparent;
      border: 0;
      min-width: 0;
      padding: 0;
      position: static;
    }

    /* Older engines hide a closed <details>' content with display:none. */
    .site-header__menu:not([open]) > nav {
      display: block;
    }

    /*
     * Current engines instead apply content-visibility to ::details-content, which keeps the
     * navigation painted but collapses it to zero width, pushing the links off-screen. Release
     * the containment so the nav sizes itself inside the header flex row.
     */
    .site-header__menu::details-content {
      content-visibility: visible;
      display: contents;
    }

    nav ul {
      display: flex;
      gap: var(--space-lg);
    }
  }
</style>
