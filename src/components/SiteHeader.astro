---
import { serviceUrls } from '../lib/services';
const navigation = [
  { href: '/music/', label: '曲を聴く' },
  { href: '/works/', label: '作品一覧' },
  { href: '/games/', label: 'ゲーム' },
  { href: '/journal/', label: '制作ノート' },
  { href: '/about/', label: '活動について' },
] as const;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrentRoute = (href: string) => {
  if (href === '/') return currentPath === '/';

  const routePath = href.replace(/\/+$/, '');
  return currentPath === routePath || currentPath.startsWith(`${routePath}/`);
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a
      class="site-header__brand"
      href="/"
      aria-label="Kanon Studioのトップページ"
      aria-current={isCurrentRoute('/') ? 'page' : undefined}
    ><span class="site-header__moon" aria-hidden="true">☾</span><span>Kanon Studio<span class="site-header__tagline">Music & little wonders</span></span></a>
    <details class="site-header__menu" open>
      <summary>メニュー</summary>
      <nav aria-label="メインナビゲーション">
        <ul>
          {navigation.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrentRoute(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))}
          {serviceUrls.x && <li><a href={serviceUrls.x} target="_blank" rel="me noopener noreferrer" class="site-header__x">Xで新作を見る <span aria-hidden="true">↗</span></a></li>}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  import { initSiteNavigation } from '../lib/site-navigation';
  initSiteNavigation();
</script>

<style>
  .site-header { background: var(--color-surface); }
  .site-header__brand { gap: 12px; }
  .site-header__moon { display: grid; place-items: center; width: 35px; height: 35px; border: 1px solid var(--color-border); border-radius: 50%; font-family: serif; font-size: 27px; color: var(--color-primary); }
  .site-header__tagline { display: block; color: var(--color-muted); font-family: var(--font-body); font-size: 9px; font-weight: 400; letter-spacing: .1em; line-height: 1.5; }
  nav { border-radius: 8px; box-shadow: 0 8px 24px #3631440a; }
  @media (min-width: 768px) { nav { box-shadow: none; } }

  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    align-items: center;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-inline: auto;
    max-width: var(--content-max-width);
    min-height: 76px;
    padding-inline: var(--page-padding);
  }

  .site-header__brand,
  summary,
  nav a {
    align-items: center;
    color: var(--color-ink);
    display: inline-flex;
    min-height: 44px;
    min-width: 44px;
    text-decoration: none;
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: var(--type-headline-md-weight);
    letter-spacing: var(--type-headline-md-letter-spacing);
  }

  .site-header__menu {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  summary { justify-content: flex-end; }

  summary {
    color: var(--color-kanon-blue);
    cursor: pointer;
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '＋';
    font-size: 1rem;
    margin-left: var(--space-xs);
  }

  details[open] summary::after {
    content: '−';
  }

  nav {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    min-width: 180px;
    padding: var(--space-sm) var(--space-md);
    position: static;
    margin-block: var(--space-xs);
  }

  nav ul {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: var(--type-body-sm-size);
  }

  nav a:hover {
    color: var(--color-kanon-blue-hover);
  }

  .site-header__x { color: var(--color-primary); gap: 6px; }

  .site-header a[aria-current='page'] {
    position: relative;
  }

  .site-header a[aria-current='page']::after {
    background: var(--color-coral);
    border-radius: var(--radius-full);
    bottom: 2px;
    content: '';
    height: 4px;
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
    width: 4px;
  }

  @media (min-width: 768px) {
    .site-header__menu {
      align-items: center;
      display: flex;
      width: auto;
    }

    summary {
      display: none;
    }

    nav {
      background: transparent;
      border: 0;
      min-width: 0;
      padding: 0;
      position: static;
      margin: 0;
    }

    nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(12px, 2vw, 24px);
    }
  }
</style>
