---
import { getCollection } from 'astro:content';
import WorkFilters from '../../components/WorkFilters.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortWorksNewestFirst } from '../../lib/content';

const works = sortWorksNewestFirst(
  (await getCollection('works')).map((work) => ({ ...work.data, work })),
).map(({ work }) => work);
---

<BaseLayout
  title="Works — Kanon Studio"
  description="Kanon Studioの音楽、ビジュアル、映像作品をまとめたアーカイブ。"
>
  <section class="works-archive" aria-labelledby="works-title">
    <header class="works-archive__header">
      <div>
        <p class="works-archive__folio">The collection / 作品集</p>
        <h1 id="works-title">Works</h1>
      </div>
      <p>音楽も、ビジュアルも。心にふれる作品を、今日の気分で見つけてください。</p>
    </header>

    <WorkFilters />

    <div class="works-archive__grid" id="works-list" aria-live="polite">
      <WorkGrid works={works} variant="archive" />
    </div>
  </section>
</BaseLayout>

<style>
  .works-archive {
    display: grid;
    gap: var(--space-xl);
  }

  .works-archive__header {
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-lg);
    padding: 10px 0 24px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
  }

  .works-archive__folio {
    color: var(--color-coral-hover);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    line-height: var(--type-label-line-height);
    margin: 0 0 var(--space-sm);
    text-transform: uppercase;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.625rem);
    font-weight: var(--type-display-weight);
    letter-spacing: var(--type-display-letter-spacing);
    line-height: var(--type-display-line-height);
    margin: 0;
  }

  .works-archive__header > p {
    color: var(--color-muted);
    margin: 0;
    max-width: 440px;
  }

  .works-archive__grid {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-xl);
  }

  @media (min-width: 768px) {
    .works-archive__header {
      align-items: end;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .works-archive__header > p {
      justify-self: end;
    }
  }
</style>
