---
import { Image } from 'astro:assets';
import mascot from '../../assets/brand/mascot-reference.jpeg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { companions, kotone, kotoneDisplayName, kotoneDisplayReading } from '../../lib/characters';
---
<BaseLayout
  title={`Characters — ${kotoneDisplayName}（${kotone.nickname}） | Kanon Studio`}
  description={`Kanon Studioの看板キャラクター、${kotoneDisplayName}（${kotone.nickname}）と仲間たちの紹介。`}
  image="/images/characters/kotone-sakura.jpeg"
  imageAlt="桜の下のベンチで頬杖をつく、白銀の髪とねこ耳の琴音"
>
  <article class="characters">
    <a class="text-link" href="/">← Kanon Studio</a>
    <section class="lead-character" aria-labelledby="kotone-title">
      <div class="lead-character__art" data-reveal>
        <img src="/images/characters/kotone-sakura.jpeg" alt="桜の下のベンチで頬杖をつく琴音。白銀の長い髪、紫の瞳、ねこ耳に金色の星飾り、黒と白のメイド服" width="1000" height="1179" fetchpriority="high" decoding="async" data-sizes="(max-width: 899px) 92vw, 520px" />
        <span class="lead-character__star" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2L5.8 21 7 14.2 2 9.3l6.9-1Z" /></svg></span>
      </div>
      <div class="lead-character__copy">
        <p class="eyebrow">Kanon Studio / Characters</p>
        <p class="role">{kotone.role}</p>
        <h1 id="kotone-title"><ruby>{kotoneDisplayName}<rp>（</rp><rt>{kotoneDisplayReading}</rt><rp>）</rp></ruby></h1>
        <p class="nickname">愛称 <strong>{kotone.nickname}</strong></p>
        <p class="lead">{kotone.lead}</p>
        <p class="name-note">{kotone.nameNote}</p>
        <dl class="traits">
          <div><dt>フルネーム</dt><dd>{kotone.fullName}<span class="roman" lang="en">{kotone.romanName}</span></dd></div>
          {kotone.origin && <div><dt>ルーツ</dt><dd>{kotone.origin}</dd></div>}
          {kotone.traits.map((trait) => <div><dt>{trait.label}</dt><dd>{trait.value}</dd></div>)}
        </dl>
        <p class="growing">プロフィールは、これから少しずつ増えていきます。</p>
      </div>
    </section>

    <section class="sheet" aria-labelledby="sheet-title" data-reveal>
      <Image class="sheet__portrait" src={mascot} alt="琴音の基準イラスト。白銀の髪と紫の瞳、ねこ耳、ピンクの丸眼鏡、金色の星飾り" width={352} loading="lazy" decoding="async" />
      <div>
        <p class="eyebrow">Where to find her</p>
        <h2 id="sheet-title">{kotone.nickname}に会える場所</h2>
        <ul>
          <li>このサイトのフッターと、活動紹介のポートレート</li>
          <li>URLを共有したときに表示されるカード</li>
          <li><a href="/works/?category=visual">イラスト作品</a>のなかにも、ときどき登場します</li>
        </ul>
      </div>
    </section>

    <section class="companions" aria-labelledby="companions-title">
      <header><p class="eyebrow">Studio members</p><h2 id="companions-title">スタジオのなかまたち</h2></header>
      <ul>
        {companions.map((character) => <li data-reveal>
          <div class="companion__art"><img src={character.image} alt={character.imageAlt} width={character.width} height={character.height} loading="lazy" decoding="async" style={`object-position:${character.position}`} data-sizes="(max-width: 767px) 92vw, 420px" /></div>
          <div class="companion__copy">
            <p class="role">{character.role}</p>
            <h3><ruby>{character.name}<rp>（</rp><rt>{character.reading}</rt><rp>）</rp></ruby></h3>
            <p>{character.description}</p>
            <a class="text-link" href={character.link.href}>{character.link.label} <span aria-hidden="true">→</span></a>
          </div>
        </li>)}
      </ul>
    </section>
  </article>
</BaseLayout>
<style>
  .characters { max-width: 1120px; margin-inline: auto; padding-block: 8px 40px; }
  .eyebrow { margin: 0 0 12px; font-size: 10px; letter-spacing: .18em; color: var(--color-primary); }
  .role { display: inline-block; margin: 0 0 14px; padding: 4px 12px; border: 1px solid #e5be70; border-radius: 999px; color: #e5be70; font-size: 11px; letter-spacing: .06em; }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 500; margin: 0; }
  rt { font-family: var(--font-body); font-size: .32em; letter-spacing: .3em; color: var(--color-muted); }
  .lead-character { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 80px); align-items: center; padding-block: clamp(20px, 4vw, 48px) clamp(48px, 7vw, 96px); }
  .lead-character__art { position: relative; }
  .lead-character__art img { width: 100%; height: auto; border-radius: 240px 240px 14px 14px; box-shadow: 0 30px 80px -30px #8f7bd6aa, 0 0 0 1px #c9b9e833; }
  .lead-character__star { position: absolute; right: 4%; top: 6%; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: #10101d; border: 1px solid #e5be7066; animation: star-twinkle 5s ease-in-out infinite; }
  .lead-character__star svg { width: 22px; height: 22px; fill: #e5be70; }
  @keyframes star-twinkle { 0%, 100% { transform: rotate(-6deg) scale(1); } 50% { transform: rotate(8deg) scale(1.12); } }
  h1 { font-size: clamp(40px, 6.4vw, 72px); font-weight: 700; letter-spacing: .08em; line-height: 1.5; }
  .nickname { margin: 4px 0 0; color: var(--color-muted); font-size: 13px; letter-spacing: .08em; }
  .nickname strong { margin-left: 10px; color: var(--color-primary); font-family: var(--font-display); font-size: 24px; font-weight: 700; letter-spacing: .06em; }
  .lead { margin: 28px 0 0; font-family: var(--font-display); font-size: clamp(17px, 2vw, 21px); line-height: 1.8; }
  .name-note { margin: 12px 0 0; color: var(--color-muted); font-size: 14px; line-height: 2; }
  .traits { margin: 28px 0 0; border-top: 1px solid var(--color-border); }
  .traits div { display: grid; grid-template-columns: 9em minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--color-border); }
  .traits dt { color: var(--color-primary); font-size: 12px; letter-spacing: .06em; }
  .traits dd { margin: 0; font-size: 14px; }
  .roman { display: block; margin-top: 2px; color: var(--color-muted); font-size: 11px; letter-spacing: .08em; }
  .growing { margin: 18px 0 0; color: var(--color-muted); font-size: 12px; }
  .sheet { display: grid; grid-template-columns: 176px minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: center; padding: clamp(24px, 4vw, 40px); border: 1px solid var(--color-border); border-radius: 16px; background: linear-gradient(160deg, #141b33, #0c1122); }
  .sheet__portrait { width: 176px; height: 176px; object-fit: cover; object-position: center top; border-radius: 50%; border: 1px solid #c9b9e8; }
  .sheet h2 { font-size: clamp(20px, 2.4vw, 26px); letter-spacing: .04em; }
  .sheet ul { margin: 16px 0 0; padding-left: 1.2em; color: var(--color-muted); font-size: 14px; line-height: 2.1; }
  .sheet a { color: var(--color-primary); text-underline-offset: 4px; }
  .companions { padding-top: clamp(56px, 8vw, 104px); }
  .companions > header { margin-bottom: 32px; }
  .companions h2 { font-size: clamp(24px, 3vw, 32px); letter-spacing: .05em; }
  .companions ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; list-style: none; margin: 0; padding: 0; }
  .companions li { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1fr); gap: 24px; align-items: center; padding: 16px; border: 1px solid var(--color-border); border-radius: 16px; background: linear-gradient(180deg, #121930, #0c1122); }
  .companion__art { aspect-ratio: 3 / 4; border-radius: 10px; overflow: hidden; background: radial-gradient(circle at 50% 30%, #1d2a4a, #0c1122); }
  .companion__art img { width: 100%; height: 100%; object-fit: cover; }
  .companions li:last-child .companion__art img { object-fit: contain; object-position: center bottom !important; padding-top: 12px; }
  .companions .role { border-color: var(--color-control-border); color: var(--color-primary); }
  .companions h3 { font-size: 26px; letter-spacing: .06em; line-height: 1.9; }
  .companions h3 rt { font-size: .38em; }
  .companion__copy > p:not(.role) { margin: 8px 0 6px; color: var(--color-muted); font-size: 13px; line-height: 1.95; }
  @media (max-width: 899px) {
    .lead-character { grid-template-columns: 1fr; }
    .lead-character__art { max-width: 460px; margin-inline: auto; }
    .companions ul { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .sheet { grid-template-columns: 1fr; justify-items: start; }
    .sheet__portrait { width: 120px; height: 120px; }
    .companions li { grid-template-columns: 1fr; }
    .companion__art { aspect-ratio: 4 / 3; }
    .traits div { grid-template-columns: 7em minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) { .lead-character__star { animation: none; } }
</style>
