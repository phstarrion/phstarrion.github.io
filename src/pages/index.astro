---
import { getCollection } from 'astro:content';
import ServiceHub from '../components/ServiceHub.astro';
import GameSpotlight from '../components/GameSpotlight.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const works = await getCollection('works');
const song = works.find((work) => work.id === 'ryuseimachi')!;
const otherSongs = works.filter((work) => work.data.category === 'music' && work.id !== song.id)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3);
const visualIds = ['visual-floral-arcade', 'visual-water-mirror', 'visual-etoile-violet'];
const visualWorks = visualIds.map((id) => works.find((work) => work.id === id)!);
const story = (await getCollection('journal')).find((entry) => entry.id === 'ryuseimachi');
const lightMotes = [
  { x: 59, y: 19, size: 2, duration: 17, delay: -3 },
  { x: 72, y: 32, size: 3, duration: 21, delay: -12 },
  { x: 83, y: 20, size: 2, duration: 19, delay: -8 },
  { x: 65, y: 58, size: 2, duration: 23, delay: -17 },
  { x: 89, y: 47, size: 3, duration: 20, delay: -5 },
  { x: 77, y: 70, size: 2, duration: 25, delay: -19 },
];
---

<BaseLayout title="Kanon Studio" description="Kanon Studioの音楽、ビジュアル、ブラウザゲーム。音と、夢の、つづき。" image="/images/atelier-moonlight.png" imageAlt="月明かりの音楽室で創作する、青い髪のKanon" theme="night">
  <section class="hero" aria-labelledby="site-title">
    <h1 id="site-title" class="visually-hidden">Kanon Studio — 音と、夢の、つづき。</h1>
    <picture>
      <source media="(max-width: 640px)" srcset="/images/atelier-moonlight-mobile.png" width="1122" height="1402" />
      <img src="/images/atelier-moonlight.png" alt="月明かりが差す音楽室で、青い髪のKanonが創作する水彩イラスト" width="1536" height="1024" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero__atmosphere" aria-hidden="true">
      <div class="hero__moonlight"></div>
      {lightMotes.map((mote) => <span class="hero__mote" style={`--x:${mote.x}%;--y:${mote.y}%;--size:${mote.size}px;--duration:${mote.duration}s;--delay:${mote.delay}s;`}></span>)}
    </div>
  </section>

  <div class="home-content">
    <section class="music home-section" aria-labelledby="music-title">
      <header class="section-heading"><div><p class="eyebrow">01 / MUSIC</p><h2 id="music-title">音楽</h2></div><a class="text-link" href="/works/?category=music">すべての音楽 <span aria-hidden="true">↗</span></a></header>
      <article class="featured-song" id="featured-song" aria-labelledby="featured-song-title">
        <a class="featured-song__cover" href="/works/ryuseimachi/" aria-label="流星待ちの作品詳細"><img src={song.data.cover} alt={song.data.coverAlt} width={song.data.coverWidth} height={song.data.coverHeight} loading="lazy" decoding="async" /></a>
        <div class="featured-song__copy">
          <p class="eyebrow">FEATURED / 今夜の一曲</p>
          <h3 id="featured-song-title">{song.data.title}</h3>
          <p class="song-description">{song.data.description}</p>
          <p class="genre">{song.data.genre}</p>
          <div class="song-actions"><a class="button" href={song.data.externalUrl} rel="noopener noreferrer" data-featured-listen><span aria-hidden="true">▷</span> Sunoで聴く <span aria-hidden="true">↗</span></a><a class="text-link" href="/works/ryuseimachi/">作品について <span aria-hidden="true">→</span></a></div>
          {story && <a class="story-link" href={`/journal/${story.id}/`}><span class="eyebrow">制作ノート</span><span>「流星待ち」の歌詞の物語を読む <span aria-hidden="true">↗</span></span></a>}
        </div>
      </article>
      <ul class="music-grid">
        {otherSongs.map((work) => <li><a class="music-card" href={`/works/${work.id}/`}><div class="music-card__art"><img src={work.data.cover} alt={work.data.coverAlt} width={work.data.coverWidth} height={work.data.coverHeight} loading="lazy" decoding="async" /><span class="music-card__arrow" aria-hidden="true">↗</span></div><h3>{work.data.title}</h3><p>{work.data.genre}</p></a></li>)}
      </ul>
    </section>

    <section class="home-section selected-works" aria-labelledby="selected-works-title">
      <header class="section-heading"><div><p class="eyebrow">02 / VISUALS</p><h2 id="selected-works-title">イラスト</h2></div><a class="text-link" href="/works/?category=visual">すべてのビジュアル <span aria-hidden="true">↗</span></a></header>
      <WorkGrid works={visualWorks} variant="featured" />
    </section>

    <section class="home-section play" aria-labelledby="play-title">
      <header class="section-heading"><div><p class="eyebrow">03 / PLAY</p><h2 id="play-title">音楽で、遊ぶ。</h2></div></header>
      <GameSpotlight />
    </section>

    <section class="atelier-about" aria-labelledby="atelier-about-title">
      <img class="atelier-about__portrait" src="/images/kanon-avatar.jpg" alt="Kanon Studioの青い髪のキャラクターポートレート" width="682" height="1024" loading="lazy" decoding="async" />
      <div class="atelier-about__copy"><p class="eyebrow">ABOUT KANON</p><h2 id="atelier-about-title">好きな世界を、少しずつ。</h2><p>音楽、ビジュアル、映像。<br />心に浮かんだ景色を、作品にしています。</p><a class="text-link" href="/about/">Kanon Studioについて <span aria-hidden="true">→</span></a></div>
      <ServiceHub headingId="home-service-hub-title" heading="Follow Kanon" />
    </section>
  </div>
</BaseLayout>

<style>
  :global(body.theme-night main) { max-width: none; padding: 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .hero { position: relative; isolation: isolate; overflow: hidden; background: #161b32; }
  .hero__atmosphere { position: absolute; inset: 0; pointer-events: none; }
  .hero__moonlight { position: absolute; inset: 0; background: radial-gradient(ellipse at 73% 17%, #fff5d8 0%, #e1e9ff66 26%, transparent 61%); opacity: .09; animation: moonlight-breathe 14s ease-in-out infinite; }
  .hero__mote { position: absolute; left: var(--x); top: var(--y); width: var(--size); height: var(--size); border-radius: 50%; background: #fff7df; box-shadow: 0 0 7px 2px #ffefc54d; opacity: 0; animation: mote-drift var(--duration) ease-in-out var(--delay) infinite; }
  @keyframes moonlight-breathe { 0%, 100% { opacity: .07; } 50% { opacity: .21; } }
  @keyframes mote-drift { 0%, 100% { opacity: 0; transform: translate3d(-5px, 12px, 0); } 25% { opacity: .45; } 55% { opacity: .65; transform: translate3d(8px, -10px, 0); } 80% { opacity: .2; } }
  @media (prefers-reduced-motion: reduce) { .hero__moonlight { animation: none; opacity: .07; } .hero__mote { display: none; } }
  .hero picture { display: block; }
  .hero img { display: block; width: 100%; height: min(76vw, 760px); max-height: calc(100svh - 76px); object-fit: cover; object-position: center 52%; }
  /* Open, editorial spacing lets the artwork carry each section. */
  .hero::after { content: ''; position: absolute; inset: auto 0 0; height: 18%; background: linear-gradient(transparent, #090d1b); pointer-events: none; }
  .home-content { max-width: 1200px; margin-inline: auto; padding: 0 var(--page-padding) 88px; }
  .home-section { padding-top: clamp(64px, 8vw, 112px); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 36px; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
  .eyebrow { color: var(--color-primary); font-size: 10px; font-weight: 500; letter-spacing: .18em; margin: 0 0 10px; }
  h2, h3 { font-family: var(--font-display); font-weight: 500; margin: 0; }
  h2 { font-size: 28px; line-height: 1.5; letter-spacing: .08em; }
  .featured-song { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(32px, 5vw, 72px); }
  .featured-song__cover { display: block; min-width: 0; overflow: hidden; border-radius: 4px; }
  .featured-song__cover img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: center 38%; transition: transform 400ms ease; }
  .featured-song__cover:hover img { transform: scale(1.025); }
  .featured-song__copy { padding-block: 24px; min-width: 0; }
  .featured-song h3 { font-size: clamp(32px, 3.5vw, 44px); letter-spacing: .08em; margin-top: 18px; }
  .song-description { max-width: 28em; font-size: 14px; color: var(--color-muted); line-height: 2; margin: 24px 0 14px; }
  .genre { font-size: 10px; letter-spacing: .04em; color: var(--color-muted); }
  .song-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 32px; }
  .story-link { display: grid; gap: 8px; margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--color-border); color: var(--color-ink); font-size: 12px; text-decoration: none; }
  .story-link .eyebrow { margin: 0; font-size: 10px; }
  .story-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .music-grid { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .music-grid li { min-width: 0; }
  .music-card { display: block; color: var(--color-ink); text-decoration: none; }
  .music-card__art { position: relative; overflow: hidden; border-radius: 4px; }
  .music-card img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; transition: transform 400ms ease; }
  .music-card:hover img { transform: scale(1.025); }
  .music-card__arrow { position: absolute; right: 14px; bottom: 14px; display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid #ffffff45; border-radius: 50%; background: #090d1bc9; color: white; font-size: 14px; }
  .music-card h3 { font-size: 16px; line-height: 1.8; margin-top: 16px; }
  .music-card p { color: var(--color-muted); font-size: 10px; letter-spacing: .03em; line-height: 1.8; margin: 6px 0 0; }
  .selected-works :global(.work-grid--featured) { gap: 32px; }
  .selected-works :global(.work-card__caption) { padding-top: 18px; gap: 8px; }
  .selected-works :global(.work-card__category) { font-size: 9px; font-weight: 400; letter-spacing: .16em; color: var(--color-primary); }
  .selected-works :global(.work-card__year) { font-size: 11px; }
  .selected-works :global(.work-card__caption h3) { font-size: 16px; }
  .play :global(.game-spotlight) { margin: 0; border: 0; padding: 0; grid-template-columns: .85fr 1.15fr; gap: clamp(32px, 5vw, 72px); }
  .play :global(.game-spotlight > div) { padding-block: 24px; }
  .play :global(.game-spotlight .art) { border-radius: 4px; }
  .play :global(.game-spotlight .art img) { height: auto; aspect-ratio: 6 / 5; object-position: center 24%; }
  .play :global(.game-spotlight h2) { font-size: clamp(22px, 2.3vw, 30px); letter-spacing: .035em; }
  .play :global(.game-spotlight .button) { margin-top: 18px; background: transparent; color: var(--color-primary); border-color: var(--color-border); }
  .play :global(.game-spotlight .button:hover) { background: var(--color-lavender); border-color: var(--color-primary); }
  .atelier-about { display: grid; grid-template-columns: 96px 1fr auto; align-items: center; gap: 32px; margin-top: 112px; border-top: 1px solid var(--color-border); padding-top: 56px; }
  .atelier-about__portrait { width: 96px; height: 120px; object-fit: cover; object-position: center top; border-radius: 48px 48px 4px 4px; }
  .atelier-about h2 { font-size: 23px; letter-spacing: .03em; }
  .atelier-about__copy > p:not(.eyebrow) { color: var(--color-muted); font-size: 13px; line-height: 1.95; margin: 14px 0 6px; }
  .atelier-about :global(.service-hub) { border-left: 1px solid var(--color-border); padding-left: 40px; }
  .atelier-about :global(.service-hub__name) { font-size: 13px; text-decoration: none; }
  .atelier-about :global(.service-hub a:hover) { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 767px) {
    .hero__mote:nth-last-child(-n+2) { display: none; }
    /* Keep the existing portrait source, 4:5 framing and centered face. */
    .hero img { height: auto; max-height: none; aspect-ratio: 4 / 5; object-position: center; }
    .hero::after { height: 12%; }
    .home-content { padding-bottom: 48px; }
    .home-section { padding-top: 56px; }
    .home-content .selected-works :global(.work-grid--featured > li:first-child .work-card__media img) { aspect-ratio: 4 / 5; object-position: center; }
    .section-heading { gap: 12px; margin-bottom: 24px; padding-bottom: 18px; }
    .section-heading > .text-link { font-size: 10px; gap: 8px; }
    h2 { font-size: 23px; }
    .featured-song { grid-template-columns: 1fr; gap: 0; }
    .featured-song__cover img { aspect-ratio: 4 / 3; object-position: center 34%; }
    .featured-song__copy { padding: 28px 0 0; }
    .featured-song h3 { font-size: 32px; margin-top: 12px; }
    .song-description { margin-top: 16px; }
    .song-actions { gap: 20px; margin-top: 22px; }
    .story-link { margin-top: 26px; padding-top: 18px; }
    .music-grid { gap: 24px 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 36px; }
    .music-grid li:last-child { grid-column: 1 / -1; }
    .music-grid li:last-child .music-card { display: grid; grid-template-columns: 90px 1fr; column-gap: 18px; align-content: center; border-block: 1px solid var(--color-border); padding-block: 18px; }
    .music-grid li:last-child .music-card__art { grid-row: 1 / 3; }
    .music-grid li:last-child h3 { margin-top: 3px; }
    .music-grid li:last-child .music-card__arrow { display: none; }
    .music-card h3 { font-size: 14px; margin-top: 12px; }
    .music-card__arrow { right: 10px; bottom: 10px; width: 28px; height: 28px; }
    .selected-works :global(.work-grid--featured) { gap: 28px 16px; }
    .selected-works :global(.work-card__caption) { gap: 6px; padding-top: 12px; }
    .selected-works :global(.work-card__caption h3) { font-size: 14px; }
    .selected-works :global(.work-card__year) { font-size: 10px; }
    .play :global(.game-spotlight) { grid-template-columns: 1fr; gap: 0; }
    .play :global(.game-spotlight .art img) { aspect-ratio: 6 / 5; }
    .play :global(.game-spotlight > div) { padding: 24px 0 0; }
    .atelier-about { grid-template-columns: 64px minmax(0, 1fr); gap: 24px 20px; margin-top: 64px; padding-top: 32px; }
    .atelier-about__portrait { width: 64px; height: 84px; align-self: start; }
    .atelier-about h2 { font-size: 19px; }
    .atelier-about :global(.service-hub) { grid-column: 2; border: 0; padding: 0; }
  }
</style>
