---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import mascot from '../assets/brand/mascot-reference.jpeg';
import ServiceHub from '../components/ServiceHub.astro';
import GameSpotlight from '../components/GameSpotlight.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MusicPreview from '../components/MusicPreview.astro';
import { getListeningCatalog } from '../lib/listening';
import LikeButton from '../components/LikeButton.astro';
import PortTeaser from '../components/PortTeaser.astro';
import NagiShowcase from '../components/NagiShowcase.astro';
import { paths } from '../lib/paths';

const works = await getCollection('works');
const recommendedTracks = getListeningCatalog(works).filter(track => track.previewAvailable !== false).slice(0, 3);
const moreTracks = getListeningCatalog(works).filter(track => track.previewAvailable !== false).slice(3);
const visualIds = ['visual-floral-arcade', 'visual-water-mirror', 'visual-etoile-violet'];
const visualWorks = visualIds.map((id) => works.find((work) => work.id === id)!);
const filmstrip = works.filter((work) => work.data.category === 'visual' && !visualIds.includes(work.id) && work.data.cover).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || a.id.localeCompare(b.id)).slice(0, 10);
const lightMotes = [
  { x: 59, y: 19, size: 2, duration: 17, delay: -3 },
  { x: 72, y: 32, size: 3, duration: 21, delay: -12 },
  { x: 83, y: 20, size: 2, duration: 19, delay: -8 },
  { x: 65, y: 58, size: 2, duration: 23, delay: -17 },
  { x: 89, y: 47, size: 3, duration: 20, delay: -5 },
  { x: 77, y: 70, size: 2, duration: 25, delay: -19 },
];
---

<BaseLayout title="Kanon Studio" description="Kanon Studioの音楽、ビジュアル、ブラウザゲーム、解説動画。音と、夢の、つづき。" theme="night">
  <section class="hero" aria-labelledby="site-title">
    <h1 id="site-title" class="visually-hidden">Kanon Studio — 音と、夢の、つづき。</h1>
    <picture>
      <source media="(max-width: 640px)" type="image/webp" srcset="/images/opt/atelier-moonlight-mobile-640.webp 640w, /images/opt/atelier-moonlight-mobile-1122.webp 1122w" sizes="100vw" width="1122" height="1402" />
      <source media="(max-width: 640px)" srcset="/images/atelier-moonlight-mobile.png" width="1122" height="1402" />
      <img src="/images/atelier-moonlight.png" alt="月明かりが差す音楽室で、青い髪のKanonが創作する水彩イラスト" width="1536" height="1024" fetchpriority="high" decoding="async" data-sizes="100vw" />
    </picture>
    <div class="hero__atmosphere" aria-hidden="true">
      <div class="hero__moonlight"></div>
      {lightMotes.map((mote) => <span class="hero__mote" style={`--x:${mote.x}%;--y:${mote.y}%;--size:${mote.size}px;--duration:${mote.duration}s;--delay:${mote.delay}s;`}></span>)}
    </div>
  </section>

  <div class="home-content">
    <nav class="section-nav" aria-label="トップページの作品カテゴリー">
      <p>今日は、何を楽しむ？</p>
      <ul>
        <li><a href="#music-title">音楽を聴く <span aria-hidden="true">↓</span></a></li>
        <li><a href="#selected-works-title">イラストを見る <span aria-hidden="true">↓</span></a></li>
        <li><a href="#play-title">ゲームで遊ぶ <span aria-hidden="true">↓</span></a></li>
        <li><a href="#watch-title">動画を見る <span aria-hidden="true">↓</span></a></li>
        <li><a href="#atelier-about-title">活動について <span aria-hidden="true">↓</span></a></li>
      </ul>
    </nav>
    <section class="music home-section" aria-labelledby="music-title">
      <header class="section-heading"><div><p class="eyebrow">01 / MUSIC</p><h2 id="music-title" tabindex="-1">音楽を聴く</h2><p class="section-description">30秒の試聴から、曲の紹介や歌詞の物語へ。</p></div><a class="text-link" href="/music/#tracks">30秒試聴できる曲をもっと聴く <span aria-hidden="true">→</span></a></header>
      <section class="listening" aria-labelledby="listening-title">
        <header class="listening__heading"><h3 id="listening-title">新しく聴ける3曲</h3><p>気になる曲を、ここで30秒試聴。<br />音源のある曲から、新しい順に。</p></header>
        <ul class="listening-grid">
          {recommendedTracks.map((track) => <li class="listening-card" data-home-track-id={track.id} data-now-playing={track.id}>
            <a class="listening-card__art" href={track.detailUrl ?? `/music/#${track.id}`} aria-label={`${track.title}の${track.detailUrl ? '紹介を見る' : '試聴ページを開く'}`}>
              {track.cover ? <img src={track.cover} alt={track.coverAlt ?? `${track.title}のジャケット`} width="320" height="320" loading="lazy" decoding="async" /> : <svg viewBox="0 0 220 220" width="220" height="220" aria-hidden="true" focusable="false"><rect width="220" height="220" fill="#292440" /><circle cx="110" cy="110" r="90" fill="#11182b" /><circle cx="110" cy="110" r="42" fill="#c4b7e6" /></svg>}
            </a>
            <button class="jacket-play" type="button" data-dock-play={track.id} data-dock-title={track.title} data-play-state="paused" aria-label={`${track.title}を30秒試聴する`}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="play-icon" d="M8 5v14l11-7z" /><path class="pause-icon" d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg></button>
            <div class="listening-card__copy"><h4>{track.title}</h4><p class="listening-card__headline">{track.headline}</p>{track.createdAt && <p class="genre">制作日 <time datetime={track.createdAt}>{track.createdAt.replaceAll('-', '.')}</time></p>}</div>
            <div class="listening-card__preview"><MusicPreview track={track} title={track.title} showHeadline={false} /></div>
            <div class="listening-card__actions">
              <LikeButton workId={track.detailUrl ? track.detailUrl.split('/')[2] : track.id} title={track.title} />
              <a class="text-link" href={`/music/#${track.id}`} aria-label={`${track.title}を試聴ページで聴く`}>試聴ページで聴く <span aria-hidden="true">→</span></a>
              {track.detailUrl && <a class="text-link" href={track.detailUrl} aria-label={`${track.title}の紹介を見る`}>曲の紹介を見る <span aria-hidden="true">→</span></a>}
            </div>
          </li>)}
        </ul>
      </section>
      {moreTracks.length > 0 && <section class="shelf" aria-labelledby="shelf-title" data-reveal>
        <header class="shelf__heading"><h3 id="shelf-title">つづけて聴く</h3><p>ジャケットを押すと、その場で30秒。ページを移っても音は続きます。</p></header>
        <ul class="shelf__list">
          {moreTracks.map((track) => <li class="shelf__item" data-now-playing={track.id}>
            <button class="shelf__play" type="button" data-dock-play={track.id} data-dock-title={track.title} data-play-state="paused" aria-label={`${track.title}を30秒試聴する`}>
              {track.cover ? <img src={track.cover} alt="" width="320" height="320" loading="lazy" decoding="async" data-sizes="(max-width: 767px) 44vw, 180px" /> : <svg class="shelf__record" viewBox="0 0 220 220" width="220" height="220" aria-hidden="true" focusable="false"><rect width="220" height="220" fill="#292440" /><circle cx="110" cy="110" r="90" fill="#11182b" /><circle cx="110" cy="110" r="42" fill="#c4b7e6" /></svg>}
              <span class="shelf__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path class="play-icon" d="M8 5v14l11-7z" /><path class="pause-icon" d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg></span>
            </button>
            <a class="shelf__title" href={track.detailUrl ?? `/music/#${track.id}`} aria-label={`${track.title}の${track.detailUrl ? '紹介を見る' : '試聴ページを開く'}`}>{track.title}</a>
          </li>)}
        </ul>
        <noscript><p class="shelf__noscript">試聴は<a href="/music/#tracks">リスニングルーム</a>でどうぞ。</p></noscript>
      </section>}
    </section>

    <section class="home-section selected-works" aria-labelledby="selected-works-title">
      <header class="section-heading"><div><p class="eyebrow">02 / VISUALS</p><h2 id="selected-works-title" tabindex="-1">イラストを見る</h2><p class="section-description">キャラクターと、光や色で描いた世界。</p></div><a class="text-link" href="/works/?category=visual">すべてのビジュアル <span aria-hidden="true">↗</span></a></header>
      <WorkGrid works={visualWorks} variant="featured" />
      {filmstrip.length > 0 && <div class="filmstrip" data-reveal>
        <p class="filmstrip__label" id="filmstrip-title">ほかのイラスト</p>
        <ul class="filmstrip__list" aria-labelledby="filmstrip-title">
          {filmstrip.map((work) => <li><a href={paths.work(work.id)} aria-label={`${work.data.title}を見る`}><img src={work.data.cover} alt="" width={work.data.coverWidth} height={work.data.coverHeight} loading="lazy" decoding="async" data-sizes="(max-width: 767px) 40vw, 200px" /><span>{work.data.title}</span></a></li>)}
        </ul>
      </div>}
    </section>

    <section class="home-section play" aria-labelledby="play-title">
      <header class="section-heading"><div><p class="eyebrow">03 / PLAY</p><h2 id="play-title" tabindex="-1">ゲームで遊ぶ</h2><p class="section-description">音楽に合わせて遊ぶ、ブラウザゲーム。</p></div></header>
      <GameSpotlight />
      <PortTeaser />
    </section>

    <section class="home-section watch" aria-labelledby="watch-title">
      <header class="section-heading"><div><p class="eyebrow">04 / WATCH</p><h2 id="watch-title" tabindex="-1">動画を見る</h2><p class="section-description">地図と地形から「なぜ」を読み解く、解説動画シリーズ。</p></div><a class="text-link" href="/videos/">シリーズの一覧 <span aria-hidden="true">→</span></a></header>
      <NagiShowcase variant="home" />
    </section>

    <section class="atelier-about" aria-labelledby="atelier-about-title">
      <Image class="atelier-about__portrait" src={mascot} alt="Kanon Studioの看板キャラクター。白銀色の髪と紫の瞳、猫耳、ピンクの丸眼鏡、金色の星飾り" width={192} loading="lazy" decoding="async" />
      <div class="atelier-about__copy"><p class="eyebrow">05 / ABOUT KANON</p><h2 id="atelier-about-title" tabindex="-1">活動について</h2><p>音楽、ビジュアル、ゲーム、映像。<br />心に浮かんだ景色を、作品にしています。</p><a class="text-link" href="/about/">Kanon Studioについて <span aria-hidden="true">→</span></a></div>
      <ServiceHub headingId="home-service-hub-title" heading="Follow Kanon" headingLevel="h3" />
    </section>
  </div>
</BaseLayout>

<script>
  import { initHomeMotion } from '../lib/home-motion';
  document.addEventListener('astro:page-load', () => initHomeMotion());
</script>

<style>
  .listening { margin-bottom: 0; }
  .listening__heading { margin-bottom: 28px; }
  .listening__heading h3 { font-size: 26px; letter-spacing: .06em; }
  .listening__heading > p:last-child { color: var(--color-muted); font-size: 13px; line-height: 1.9; margin: 12px 0 0; }
  .listening-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; list-style: none; padding: 0; margin: 0; }
  .listening-card { min-width: 0; display: grid; grid-template-rows: auto 1fr auto auto; align-content: start; gap: 20px; }
  .listening-card__preview, .listening-card__actions { min-width: 0; }
  .listening-card__actions { display: flex; flex-direction: column; align-items: start; }
  .listening-card__actions :global(.work-like) { margin-block: 0 8px; }
  .listening-card__art { display: block; overflow: hidden; border-radius: 4px; }
  .listening-card__art svg { display: block; width: 100%; height: auto; aspect-ratio: 1; }
  .listening-card__art img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: center; transition: transform 400ms ease; }
  .listening-card__art:hover img { transform: scale(1.025); }
  .listening-card__copy { padding: 0; }
  .listening-card__headline { color: var(--color-primary); font-size: 13px; line-height: 1.9; margin: 12px 0 8px; }
  .listening-card h4 { font-family: var(--font-display); font-size: 21px; font-weight: 500; letter-spacing: .04em; line-height: 1.6; margin: 0; }
  @media (max-width: 767px) {
    .listening-grid { grid-template-columns: 1fr; gap: 36px; }
    .listening__heading h3 { font-size: 23px; }
    .listening-card { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto auto auto; gap: 16px; align-items: start; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
    .listening-card__art { width: 100%; max-width: 480px; justify-self: center; }
    .listening-card__art img { display: block; aspect-ratio: 1; object-position: center; }
    .listening-card__preview, .listening-card__actions { grid-column: 1 / -1; }
    .listening-card__copy { padding: 0; }
    .listening-card__headline { font-size: 12px; margin-bottom: 6px; }
    .listening-card h4 { font-size: 21px; }
  }
  /* Motion is confined to Home; native scrolling and all links stay available. */
    :global(body.theme-night) { scroll-padding-top: 92px; }
  :global(body.theme-night :is(h2, h3, section, article)[id]) { scroll-margin-top: 92px; }
  :global(.home-content .section-heading), :global(.listening-grid > li),
  :global(.selected-works .work-grid > li),
  :global(.play .game-spotlight), .atelier-about {
    opacity: 1; transform: none;
    transition: opacity 700ms ease var(--reveal-delay, 0ms), transform 700ms cubic-bezier(.22, 1, .36, 1) var(--reveal-delay, 0ms);
  }
  :global(.home-content .motion-pending) { opacity: 0; transform: translate3d(0, 22px, 0); }
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .hero picture { transform: translate3d(0, var(--art-shift, 0px), 0) scale(1.05); }
    .hero__atmosphere { transform: translate3d(0, var(--light-shift, 0px), 0); }
  }
  @media (max-width: 767px) { :global(.home-content .motion-pending) { transform: translate3d(0, 12px, 0); } }
  @media (prefers-reduced-motion: reduce) { :global(.home-content .motion-pending) { opacity: 1; } }
  :global(body.theme-night main) { max-width: none; padding: 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .hero { position: relative; isolation: isolate; overflow: hidden; background: #161b32; }
  .hero__atmosphere { position: absolute; inset: 0; pointer-events: none; }
  .hero__moonlight { position: absolute; inset: 0; background: radial-gradient(ellipse at 73% 17%, #fff5d8 0%, #e1e9ff66 26%, transparent 61%); opacity: .09; animation: moonlight-breathe 4s ease-in-out 1; }
  .hero__mote { position: absolute; left: var(--x); top: var(--y); width: var(--size); height: var(--size); border-radius: 50%; background: #fff7df; box-shadow: 0 0 7px 2px #ffefc54d; opacity: 0; animation: mote-drift 4s ease-in-out 1; }
  @keyframes moonlight-breathe { 0%, 100% { opacity: .07; } 50% { opacity: .21; } }
  @keyframes mote-drift { 0%, 100% { opacity: 0; transform: translate3d(-5px, 12px, 0); } 25% { opacity: .45; } 55% { opacity: .65; transform: translate3d(8px, -10px, 0); } 80% { opacity: .2; } }
  @media (prefers-reduced-motion: reduce) { .hero__moonlight { animation: none; opacity: .07; } .hero__mote { display: none; } }
  .hero picture { display: block; }
  .hero img { display: block; width: 100%; height: min(76vw, 760px); max-height: calc(100svh - 76px); object-fit: cover; object-position: center 52%; }
  /* Open, editorial spacing lets the artwork carry each section. */
  .hero::after { content: ''; position: absolute; inset: auto 0 0; height: 18%; background: linear-gradient(transparent, #090d1b); pointer-events: none; }
  .home-content { max-width: 1200px; margin-inline: auto; padding: 0 var(--page-padding) 88px; }
  .home-section { padding-top: clamp(64px, 8vw, 112px); }
  .section-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 36px; padding: 24px 28px; border-left: 3px solid var(--color-primary); border-radius: 0 8px 8px 0; background: var(--color-surface); }
  .section-heading > div { min-width: 0; }
  .section-heading h2 { font-size: clamp(28px, 3.5vw, 36px); font-weight: 700; letter-spacing: .04em; }
  .section-description { color: var(--color-muted); font-size: 13px; line-height: 1.9; margin: 8px 0 0; }
  .section-nav { padding-top: 32px; }
  .section-nav > p { color: var(--color-muted); font-size: 13px; margin: 0 0 12px; }
  .section-nav ul { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .section-nav a { display: inline-flex; align-items: center; gap: 14px; min-height: 44px; padding: 10px 16px; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-surface); color: var(--color-ink); font-size: 13px; text-decoration: none; }
  .section-nav a:hover { border-color: var(--color-primary); color: var(--color-primary-hover); }
  .section-nav a span { color: var(--color-primary); }
  .home-section + .home-section { margin-top: clamp(48px, 6vw, 80px); padding-top: 40px; border-top: 1px solid #ffffff35; }
  .eyebrow { color: var(--color-primary); font-size: 10px; font-weight: 500; letter-spacing: .18em; margin: 0 0 10px; }
  h2, h3 { font-family: var(--font-display); font-weight: 500; margin: 0; }
  h2 { font-size: 28px; line-height: 1.5; letter-spacing: .08em; }
  .genre { font-size: 10px; letter-spacing: .04em; color: var(--color-muted); }
  .selected-works :global(.work-grid--featured) { gap: 32px; }
  .selected-works :global(.work-card__caption) { padding-top: 18px; gap: 8px; }
  .selected-works :global(.work-card__category) { font-size: 9px; font-weight: 400; letter-spacing: .16em; color: var(--color-primary); }
  .selected-works :global(.work-card__year) { font-size: 11px; }
  .selected-works :global(.work-card__caption h3) { font-size: 16px; }
  .play :global(.game-spotlight) { margin: 0; border: 0; padding: 0; grid-template-columns: .85fr 1.15fr; gap: clamp(32px, 5vw, 72px); }
  .play :global(.game-spotlight > div) { padding-block: 24px; }
  .play :global(.game-spotlight .art) { border-radius: 4px; }
  .play :global(.game-spotlight .art img) { height: auto; aspect-ratio: 6 / 5; object-position: center 24%; }
  .play :global(.game-spotlight h3) { font-size: clamp(22px, 2.3vw, 30px); letter-spacing: .035em; }
  .play :global(.game-spotlight .button) { margin-top: 18px; background: transparent; color: var(--color-primary); border-color: var(--color-border); }
  .play :global(.game-spotlight .button:hover) { background: var(--color-lavender); border-color: var(--color-primary); }
  .atelier-about { display: grid; grid-template-columns: 96px 1fr auto; align-items: center; gap: 32px; margin-top: 112px; border-top: 1px solid var(--color-border); padding-top: 56px; }
  .atelier-about__portrait { width: 96px; height: 120px; object-fit: cover; object-position: center top; border-radius: 48px 48px 4px 4px; }
  .atelier-about h2 { font-size: 23px; letter-spacing: .03em; }
  .atelier-about__copy > p:not(.eyebrow) { color: var(--color-muted); font-size: 13px; line-height: 1.95; margin: 14px 0 6px; }
  .atelier-about :global(.service-hub) { border-left: 1px solid var(--color-border); padding-left: 40px; }
  .atelier-about :global(.service-hub__name) { font-size: 13px; text-decoration: none; }
  .atelier-about :global(.service-hub a:hover) { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 767px) {
    .hero__mote:nth-last-child(-n+2) { display: none; }
    /* Keep the existing portrait source, 4:5 framing and centered face. */
    .hero img { height: auto; max-height: none; aspect-ratio: 4 / 5; object-position: center; }
    .hero::after { height: 12%; }
    .home-content { padding-bottom: 48px; }
    .home-section { padding-top: 56px; }
    .home-content .selected-works :global(.work-grid--featured > li:first-child .work-card__media img) { aspect-ratio: 4 / 5; object-position: center; }
    .section-heading { gap: 12px; margin-bottom: 24px; padding: 20px; }
    .section-heading h2 { font-size: 28px; }
    .section-nav ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .section-nav a { width: 100%; justify-content: space-between; padding: 10px 12px; font-size: 12px; }
    .section-heading > .text-link { font-size: 10px; gap: 8px; }
    h2 { font-size: 23px; }
    .selected-works :global(.work-grid--featured) { gap: 28px 16px; }
    .selected-works :global(.work-card__caption) { gap: 6px; padding-top: 12px; }
    .selected-works :global(.work-card__caption h3) { font-size: 14px; }
    .selected-works :global(.work-card__year) { font-size: 10px; }
    .play :global(.game-spotlight) { grid-template-columns: 1fr; gap: 0; }
    .play :global(.game-spotlight .art img) { aspect-ratio: 6 / 5; }
    .play :global(.game-spotlight > div) { padding: 24px 0 0; }
    .atelier-about { grid-template-columns: 64px minmax(0, 1fr); gap: 24px 20px; margin-top: 64px; padding-top: 32px; }
    .atelier-about__portrait { width: 64px; height: 84px; align-self: start; }
    .atelier-about h2 { font-size: 19px; }
    .atelier-about :global(.service-hub) { grid-column: 2; border: 0; padding: 0; }
  }

  /* —— 2026-11 renewal: listening shelf, filmstrip, richer cards —— */
  .section-nav ul { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .section-nav a { width: 100%; justify-content: space-between; padding: 16px 18px; border-radius: 10px; background: linear-gradient(160deg, #161d36, #0f1528); font-family: var(--font-display); font-size: 14px; letter-spacing: .04em; transition: border-color 200ms ease, transform 200ms ease, background 200ms ease; }
  .section-nav a:hover { transform: translateY(-2px); background: linear-gradient(160deg, #1d2444, #131a31); }
  .section-nav ul { counter-reset: section; }
  .section-nav a::before { counter-increment: section; content: '0' counter(section); font-family: var(--font-body); font-size: 10px; letter-spacing: .14em; color: var(--color-muted); }
  .section-nav a > span { margin-left: auto; }
