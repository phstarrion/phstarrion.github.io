---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import mascot from '../assets/brand/mascot-reference.jpeg';
import ServiceHub from '../components/ServiceHub.astro';
import GameSpotlight from '../components/GameSpotlight.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import MusicPreview from '../components/MusicPreview.astro';
import { getListeningCatalog } from '../lib/listening';
import LikeButton from '../components/LikeButton.astro';
import PortTeaser from '../components/PortTeaser.astro';
import NagiShowcase from '../components/NagiShowcase.astro';
import { paths } from '../lib/paths';

const works = await getCollection('works');
const recommendedTracks = getListeningCatalog(works).filter(track => track.previewAvailable !== false).slice(0, 3);
const moreTracks = getListeningCatalog(works).filter(track => track.previewAvailable !== false).slice(3);
const visualIds = ['visual-floral-arcade', 'visual-water-mirror', 'visual-etoile-violet'];
const visualWorks = visualIds.map((id) => works.find((work) => work.id === id)!);
const filmstrip = works.filter((work) => work.data.category === 'visual' && !visualIds.includes(work.id) && work.data.cover).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime() || a.id.localeCompare(b.id)).slice(0, 10);
const heroTitle = ['Kanon', 'Studio'];
const heroTagline = '音と、夢の、つづき。';
const marquee = ['MUSIC', 'ILLUSTRATION', 'GAME', 'MOVIE', 'KANON STUDIO', 'ことにゃん'];
---

<BaseLayout title="Kanon Studio" description="Kanon Studioの音楽、ビジュアル、ブラウザゲーム、解説動画。音と、夢の、つづき。" image="/images/social/kanon-studio-v1.jpg">
  <section class="hero" aria-labelledby="site-title" data-hero>
    <canvas class="hero__canvas" aria-hidden="true" data-hero-canvas></canvas>
    <div class="hero__blobs" aria-hidden="true"><span class="blob blob--a"></span><span class="blob blob--b"></span><span class="blob blob--c"></span></div>
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__hello"><span>WELCOME TO</span></p>
        <h1 id="site-title" class="hero__title" aria-label={`Kanon Studio — ${heroTagline}`}><span class="hero__logo" aria-hidden="true">{heroTitle.map((word, w) => <span class="hero__word">{[...word].map((letter, i) => <span class="hero__letter" style={`--i:${w * 5 + i}`}>{letter}</span>)}</span><Fragment>{w === 0 ? ' ' : ''}</Fragment>)}</span><span class="visually-hidden"> — </span><span class="hero__tagline" aria-hidden="true">{[...heroTagline].map((letter, i) => <span style={`--i:${i}`}>{letter}</span>)}</span></h1>
        <p class="hero__lead">音楽、イラスト、ゲーム、動画。<br />ぜんぶ、ここであそべます。</p>
        <div class="hero__actions">
          {recommendedTracks[0] && <button class="button hero__play" type="button" data-dock-play={recommendedTracks[0].id} data-dock-title={recommendedTracks[0].title} data-play-state="paused" aria-label={`${recommendedTracks[0].title}を30秒試聴する`}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="play-icon" d="M8 5v14l11-7z" /><path class="pause-icon" d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg><span>新曲を30秒きく</span></button>}
          <a class="button button--ghost" href="/characters/">ことにゃんに会う <span aria-hidden="true">→</span></a>
        </div>
        <noscript><p class="hero__noscript"><a href="/music/#tracks">30秒試聴はこちら</a></p></noscript>
      </div>
      <div class="hero__stage" data-hero-stage>
        <svg class="hero__ring" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><defs><path id="hero-ring-path" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0" /></defs><text><textPath href="#hero-ring-path">KANON STUDIO ★ MUSIC &amp; LITTLE WONDERS ★ KOTONYAN ★ </textPath></text></svg>
        <span class="hero__halo" aria-hidden="true"></span>
        <button class="hero__kotone" type="button" aria-label="ことにゃんをつつく" data-kotone>
          <img src="/images/characters/kotone-sticker.webp" srcset="/images/characters/kotone-sticker-566.webp 566w, /images/characters/kotone-sticker.webp 1132w" sizes="(max-width: 899px) 86vw, 560px" alt="頬杖をつく看板キャラクターの琴音（ことにゃん）。白銀の髪、紫の瞳、ねこ耳に金色の星飾り" width="1132" height="930" fetchpriority="high" decoding="async" />
        </button>
        <p class="hero__bubble" aria-live="polite" data-kotone-bubble>つついてみて</p>
        <div class="hero__eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
        <svg class="deco deco--star" style="--d:.9;--x:4%;--y:10%;--tilt:-12deg;--c:var(--pop-yellow)" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 1.5 3.2 6.6 7.3 1-5.3 5.1 1.3 7.3L12 18l-6.5 3.5 1.3-7.3L1.5 9.1l7.3-1Z" /></svg>
        <svg class="deco deco--note" style="--d:.5;--x:86%;--y:6%;--tilt:10deg;--c:var(--pop-pink)" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3v11.2A3.5 3.5 0 1 0 11 17V7h7V3z" /></svg>
        <svg class="deco deco--heart" style="--d:.7;--x:92%;--y:58%;--tilt:14deg;--c:var(--pop-pink)" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21 3.2 12.4a5.5 5.5 0 0 1 7.8-7.8l1 1.1 1-1.1a5.5 5.5 0 0 1 7.8 7.8Z" /></svg>
        <svg class="deco deco--spark" style="--d:1.2;--x:0%;--y:62%;--tilt:0deg;--c:var(--pop-mint)" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1c.8 6 3 8.800 10 11-7 2.200-9.200 5-10 11-.8-6-3-8.800-10-11 7-2.200 9.200-5 10-11Z" /></svg>
        <svg class="deco deco--star" style="--d:.4;--x:74%;--y:84%;--tilt:18deg;--c:var(--pop-sky)" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 1.5 3.2 6.6 7.3 1-5.3 5.1 1.3 7.3L12 18l-6.5 3.500 1.3-7.3L1.5 9.1l7.3-1Z" /></svg>
        <svg class="deco deco--note" style="--d:1;--x:14%;--y:86%;--tilt:-8deg;--c:var(--pop-lav)" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4v10.2A3.500 3.500 0 1 0 10 17V8.500l8-2V13a3.500 3.500 0 1 0 2 3V2z" /></svg>
      </div>
    </div>
    <div class="hero__marquee" aria-hidden="true"><div class="hero__marquee-track">{[0, 1].map(() => <span>{marquee.map((word) => <Fragment><b>{word}</b><svg viewBox="0 0 24 24"><path d="m12 1.500 3.200 6.600 7.300 1-5.300 5.100 1.300 7.300L12 18l-6.500 3.500 1.300-7.300L1.500 9.100l7.300-1Z" /></svg></Fragment>)}</span>)}</div></div>
  </section>

  <div class="home-content">
    <nav class="section-nav" aria-label="トップページの作品カテゴリー">
      <p>今日は、何を楽しむ？</p>
      <ul>
        <li><a href="#music-title">音楽を聴く <span aria-hidden="true">↓</span></a></li>
        <li><a href="#selected-works-title">イラストを見る <span aria-hidden="true">↓</span></a></li>
        <li><a href="#play-title">ゲームで遊ぶ <span aria-hidden="true">↓</span></a></li>
        <li><a href="#watch-title">動画を見る <span aria-hidden="true">↓</span></a></li>
        <li><a href="#atelier-about-title">活動について <span aria-hidden="true">↓</span></a></li>
      </ul>
    </nav>
    <section class="music home-section" style="--accent:var(--pop-lav);--accent-soft:var(--pop-lav-soft)" aria-labelledby="music-title">
      <header class="section-heading"><div><p class="eyebrow"><span>01</span>MUSIC</p><h2 id="music-title" tabindex="-1">音楽を聴く</h2><p class="section-description">30秒の試聴から、曲の紹介や歌詞の物語へ。</p></div><a class="text-link" href="/music/#tracks">30秒試聴できる曲をもっと聴く <span aria-hidden="true">→</span></a></header>
      <section class="listening" aria-labelledby="listening-title">
        <header class="listening__heading"><h3 id="listening-title">新しく聴ける3曲</h3><p>気になる曲を、ここで30秒試聴。<br />音源のある曲から、新しい順に。</p></header>
        <ul class="listening-grid">
          {recommendedTracks.map((track) => <li class="listening-card" data-home-track-id={track.id} data-now-playing={track.id}>
            <a class="listening-card__art" href={track.detailUrl ?? `/music/#${track.id}`} aria-label={`${track.title}の${track.detailUrl ? '紹介を見る' : '試聴ページを開く'}`}>
              {track.cover ? <img src={track.cover} alt={track.coverAlt ?? `${track.title}のジャケット`} width="320" height="320" loading="lazy" decoding="async" /> : <svg viewBox="0 0 220 220" width="220" height="220" aria-hidden="true" focusable="false"><rect width="220" height="220" fill="#efe8ff" /><circle cx="110" cy="110" r="90" fill="#3f3559" /><circle cx="110" cy="110" r="42" fill="#ffd45e" /></svg>}
            </a>
            <button class="jacket-play" type="button" data-dock-play={track.id} data-dock-title={track.title} data-play-state="paused" aria-label={`${track.title}を30秒試聴する`}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="play-icon" d="M8 5v14l11-7z" /><path class="pause-icon" d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg></button>
            <div class="listening-card__copy"><h4>{track.title}</h4><p class="listening-card__headline">{track.headline}</p>{track.createdAt && <p class="genre">制作日 <time datetime={track.createdAt}>{track.createdAt.replaceAll('-', '.')}</time></p>}</div>
            <div class="listening-card__preview"><MusicPreview track={track} title={track.title} showHeadline={false} /></div>
            <div class="listening-card__actions">
              <LikeButton workId={track.detailUrl ? track.detailUrl.split('/')[2] : track.id} title={track.title} />
              <a class="text-link" href={`/music/#${track.id}`} aria-label={`${track.title}を試聴ページで聴く`}>試聴ページで聴く <span aria-hidden="true">→</span></a>
              {track.detailUrl && <a class="text-link" href={track.detailUrl} aria-label={`${track.title}の紹介を見る`}>曲の紹介を見る <span aria-hidden="true">→</span></a>}
            </div>
          </li>)}
        </ul>
      </section>
      {moreTracks.length > 0 && <section class="shelf" aria-labelledby="shelf-title" data-reveal>
        <header class="shelf__heading"><h3 id="shelf-title">つづけて聴く</h3><p>ジャケットを押すと、その場で30秒。ページを移っても音は続きます。</p></header>
        <ul class="shelf__list">
          {moreTracks.map((track) => <li class="shelf__item" data-now-playing={track.id}>
            <button class="shelf__play" type="button" data-dock-play={track.id} data-dock-title={track.title} data-play-state="paused" aria-label={`${track.title}を30秒試聴する`}>
              {track.cover ? <img src={track.cover} alt="" width="320" height="320" loading="lazy" decoding="async" data-sizes="(max-width: 767px) 44vw, 180px" /> : <svg class="shelf__record" viewBox="0 0 220 220" width="220" height="220" aria-hidden="true" focusable="false"><rect width="220" height="220" fill="#efe8ff" /><circle cx="110" cy="110" r="90" fill="#3f3559" /><circle cx="110" cy="110" r="42" fill="#ffd45e" /></svg>}
              <span class="shelf__icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path class="play-icon" d="M8 5v14l11-7z" /><path class="pause-icon" d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg></span>
            </button>
            <a class="shelf__title" href={track.detailUrl ?? `/music/#${track.id}`} aria-label={`${track.title}の${track.detailUrl ? '紹介を見る' : '試聴ページを開く'}`}>{track.title}</a>
          </li>)}
        </ul>
        <noscript><p class="shelf__noscript">試聴は<a href="/music/#tracks">リスニングルーム</a>でどうぞ。</p></noscript>
      </section>}
    </section>

    <section class="home-section selected-works" style="--accent:var(--pop-pink);--accent-soft:var(--pop-pink-soft)" aria-labelledby="selected-works-title">
      <header class="section-heading"><div><p class="eyebrow"><span>02</span>VISUALS</p><h2 id="selected-works-title" tabindex="-1">イラストを見る</h2><p class="section-description">キャラクターと、光や色で描いた世界。</p></div><a class="text-link" href="/works/?category=visual">すべてのビジュアル <span aria-hidden="true">↗</span></a></header>
      <WorkGrid works={visualWorks} variant="featured" />
      {filmstrip.length > 0 && <div class="filmstrip" data-reveal>
        <p class="filmstrip__label" id="filmstrip-title">ほかのイラスト</p>
        <ul class="filmstrip__list" aria-labelledby="filmstrip-title">
          {filmstrip.map((work) => <li><a href={paths.work(work.id)} aria-label={`${work.data.title}を見る`}><img src={work.data.cover} alt="" width={work.data.coverWidth} height={work.data.coverHeight} loading="lazy" decoding="async" data-sizes="(max-width: 767px) 40vw, 200px" /><span>{work.data.title}</span></a></li>)}
        </ul>
      </div>}
    </section>

    <section class="home-section play" style="--accent:var(--pop-mint);--accent-soft:var(--pop-mint-soft)" aria-labelledby="play-title">
      <header class="section-heading"><div><p class="eyebrow"><span>03</span>PLAY</p><h2 id="play-title" tabindex="-1">ゲームで遊ぶ</h2><p class="section-description">音楽に合わせて遊ぶ、ブラウザゲーム。</p></div></header>
      <GameSpotlight />
      <PortTeaser />
    </section>

    <section class="home-section watch" style="--accent:var(--pop-sky);--accent-soft:var(--pop-sky-soft)" aria-labelledby="watch-title">
      <header class="section-heading"><div><p class="eyebrow"><span>04</span>WATCH</p><h2 id="watch-title" tabindex="-1">動画を見る</h2><p class="section-description">地図と地形から「なぜ」を読み解く、解説動画シリーズ。</p></div><a class="text-link" href="/videos/">シリーズの一覧 <span aria-hidden="true">→</span></a></header>
      <NagiShowcase variant="home" />
    </section>

    <section class="atelier-about" aria-labelledby="atelier-about-title">
      <Image class="atelier-about__portrait" src={mascot} alt="Kanon Studioの看板キャラクター、琴音。白銀色の髪と紫の瞳、猫耳、ピンクの丸眼鏡、金色の星飾り" width={192} loading="lazy" decoding="async" />
      <div class="atelier-about__copy"><p class="eyebrow"><span>05</span>ABOUT</p><h2 id="atelier-about-title" tabindex="-1">活動について</h2><p>音楽、ビジュアル、ゲーム、映像。<br />心に浮かんだ景色を、作品にしています。</p><p class="atelier-about__mascot">看板キャラクターは、<a href="/characters/">瀬尾 琴音（ことにゃん）</a>。</p><a class="text-link" href="/about/">Kanon Studioについて <span aria-hidden="true">→</span></a></div>
      <ServiceHub headingId="home-service-hub-title" heading="Follow Kanon" headingLevel="h3" />
    </section>
  </div>
</BaseLayout>

<script>
  import { initHomeMotion } from '../lib/home-motion';
  import { initHeroPlay } from '../lib/hero-play';
  document.addEventListener('astro:page-load', () => { initHomeMotion(); initHeroPlay(); });
</script>

<style>
  :global(body.theme-pop main) { max-width: none; padding: 0; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .pause-icon { display: none; }
  [data-play-state="playing"] .play-icon { display: none; }
  [data-play-state="playing"] .pause-icon { display: block; }

  /* ───────── Hero ───────── */
  .hero { position: relative; isolation: isolate; overflow: hidden; overflow: clip; margin-top: -84px; padding-top: 84px; background: linear-gradient(180deg, #f3ebff 0%, #ffeef5 55%, #fff8f4 100%); touch-action: manipulation; }
  .hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; }
  .hero__blobs { position: absolute; inset: 0; z-index: -1; filter: blur(2px); }
  .blob { position: absolute; border-radius: 44% 56% 62% 38% / 48% 42% 58% 52%; animation: blob-morph 14s ease-in-out infinite alternate; }
  .blob--a { width: 46vw; height: 46vw; max-width: 620px; max-height: 620px; right: -6%; top: 4%; background: #ffd9e8; }
  .blob--b { width: 30vw; height: 30vw; max-width: 380px; max-height: 380px; left: -8%; top: 46%; background: #d9f5ec; animation-duration: 18s; animation-delay: -6s; }
  .blob--c { width: 22vw; height: 22vw; max-width: 280px; max-height: 280px; left: 34%; top: -8%; background: #fff0b8; animation-duration: 11s; animation-delay: -3s; }
  @keyframes blob-morph { 0% { border-radius: 44% 56% 62% 38% / 48% 42% 58% 52%; transform: rotate(0) scale(1); } 100% { border-radius: 60% 40% 38% 62% / 40% 60% 42% 58%; transform: rotate(24deg) scale(1.08); } }
  .hero__inner { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); align-items: center; gap: clamp(16px, 3vw, 48px); max-width: 1200px; margin-inline: auto; padding: clamp(28px, 5vw, 64px) var(--page-padding) clamp(36px, 5vw, 64px); }
  .hero__hello { margin: 0 0 6px; }
  .hero__hello span { display: inline-block; padding: 5px 14px; border: 2.5px solid var(--pop-plum); border-radius: 999px; background: #fff; font-family: var(--font-latin); font-weight: 600; font-size: 12px; letter-spacing: .16em; color: var(--pop-plum); transform: rotate(-4deg); animation: pop-in 600ms cubic-bezier(.3,1.5,.5,1) both; }
  .hero__title { margin: 0; line-height: 1; }
  .hero__logo { display: block; font-family: var(--font-latin); font-weight: 700; font-size: clamp(54px, 9.4vw, 128px); letter-spacing: -.01em; line-height: .98; color: var(--pop-plum); }
  .hero__word { display: block; white-space: nowrap; }
  .hero__word:nth-child(2) { color: var(--color-primary); margin-left: .36em; }
  .hero__letter { display: inline-block; animation: letter-drop 900ms cubic-bezier(.2,1.7,.4,1) both; animation-delay: calc(var(--i) * 70ms + 150ms); text-shadow: 0 .05em 0 #ffffff, 0 .09em 0 #3f355920; transition: transform 220ms cubic-bezier(.3,1.8,.5,1), color 200ms ease; }
  .hero__letter:hover { transform: translateY(-.12em) rotate(-6deg) scale(1.08); color: var(--pop-pink); }
  @keyframes letter-drop { 0% { opacity: 0; transform: translateY(-.7em) rotate(-14deg) scale(.6); } 100% { opacity: 1; transform: none; } }
  .hero__tagline { display: inline-block; margin-top: clamp(14px, 2vw, 22px); padding: 8px 18px; border-radius: 14px; background: var(--pop-plum); color: #fff; font-family: var(--font-display); font-size: clamp(16px, 2.2vw, 24px); letter-spacing: .1em; transform: rotate(-2deg); box-shadow: 5px 5px 0 var(--pop-yellow); }
  .hero__tagline span { display: inline-block; animation: tagline-wave 2.6s ease-in-out infinite; animation-delay: calc(var(--i) * 90ms); }
  @keyframes tagline-wave { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-.22em); } }
  .hero__lead { margin: clamp(20px, 3vw, 32px) 0 0; font-size: clamp(15px, 1.6vw, 18px); font-weight: 700; line-height: 1.9; color: var(--pop-plum); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 22px; }
  :global(body.theme-pop) .hero__play { gap: 10px; cursor: pointer; background: var(--pop-pink); }
  :global(body.theme-pop) .hero__play:hover { background: #ffa6c6; }
  .hero__play svg { width: 22px; height: 22px; fill: currentColor; }
  :global(body.theme-pop) .button--ghost { background: #fff; }
  :global(body.theme-pop) .button--ghost:hover { background: var(--pop-lav-soft); }
  :global(html:not(.dock-ready)) .hero__play { display: none; }
  .hero__noscript { margin: 12px 0 0; font-size: 13px; }

  .hero__stage { --px: 0; --py: 0; position: relative; aspect-ratio: 1 / .92; max-width: 600px; width: 100%; justify-self: center; animation: pop-in 800ms cubic-bezier(.3,1.4,.5,1) 200ms both; }
  .hero__halo { position: absolute; inset: 9% 7% 3% 7%; border-radius: 50%; background: radial-gradient(circle at 50% 40%, #ffffff 0 46%, #fff6c9 47% 58%, #ffd1e3 59% 70%, #d8c9ff 71% 100%); border: 3px solid var(--pop-plum); box-shadow: 0 10px 0 #3f355922; transform: translate(calc(var(--px) * -10px), calc(var(--py) * -10px)); transition: transform 500ms cubic-bezier(.2,.8,.2,1); }
  .hero__ring { position: absolute; inset: -2% -4% -8% -4%; width: 108%; height: 110%; animation: pop-spin 38s linear infinite; pointer-events: none; }
  .hero__ring text { font-family: var(--font-latin); font-weight: 600; font-size: 10.6px; letter-spacing: .2em; fill: var(--pop-plum); }
  .hero__kotone { position: absolute; inset: 4% 3% 0 3%; display: block; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 40%; -webkit-tap-highlight-color: transparent; transform: translate(calc(var(--px) * 16px), calc(var(--py) * 12px)); transition: transform 500ms cubic-bezier(.2,.8,.2,1); clip-path: inset(-10% -10% 6% -10% round 0 0 46% 46%); }
  .hero__kotone img { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; filter: drop-shadow(0 8px 0 #3f35591f); transform-origin: 50% 100%; animation: kotone-breathe 4.2s ease-in-out infinite; }
  @keyframes kotone-breathe { 0%, 100% { transform: scale(1) rotate(-.6deg); } 50% { transform: scale(1.018, 1.03) rotate(.6deg); } }
  .hero__kotone:global(.is-poked) img { animation: kotone-poke 620ms cubic-bezier(.3,1.6,.5,1); }
  @keyframes kotone-poke { 0% { transform: scale(1); } 22% { transform: scale(1.1, .86); } 48% { transform: scale(.93, 1.1) translateY(-4%); } 72% { transform: scale(1.04, .97); } 100% { transform: scale(1); } }
  .hero:global(.is-playing) .hero__kotone img { animation: kotone-beat 706ms cubic-bezier(.4,0,.2,1) infinite; }
