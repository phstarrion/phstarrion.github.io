---
import { getCollection } from 'astro:content';
import JournalRow from '../components/JournalRow.astro';
import ServiceHub from '../components/ServiceHub.astro';
import GameSpotlight from '../components/GameSpotlight.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const works = await getCollection('works');
const song = works.find((work) => work.id === 'ryuseimachi')!;
const visualIds = ['visual-starlit-maid', 'visual-etoile-violet', 'visual-window-maid'];
const visualWorks = visualIds.map((id) => works.find((work) => work.id === id)!);
const journal = (await getCollection('journal'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 3);
const moods = [
  { id: 'kawaii', title: 'Kawaii', symbol: '✧', note: '甘い声、はずむビート。', detail: 'ときめきを、ひとさじ。' },
  { id: 'dark', title: 'Dark', symbol: '☾', note: '深い夜、鋭いリズム。', detail: '心の奥まで、潜る。' },
  { id: 'pop', title: 'Pop', symbol: '♫', note: '日常に、物語のメロディ。', detail: 'いつもの景色が、少し変わる。' },
];
---

<BaseLayout title="Kanon Studio" description="音と、夢の、つづき。Kanon Studioの音楽とビジュアル、制作ノートを集めた小さなアトリエ。" image="/images/atelier-moonlight.png" imageAlt="月明かりの音楽室で創作する、青い髪のKanon">
  <section class="hero" aria-labelledby="site-title">
    <div class="hero__copy">
      <p class="eyebrow"><span aria-hidden="true">✧</span> A little atelier of music & dreams</p>
      <h1 id="site-title">音と、夢の、<br />つづき。</h1>
      <p class="hero__description">心が動いた、その瞬間を。<br />音楽とビジュアルで紡ぐ、小さな物語。</p>
      <div class="hero__actions">
        <a class="button" href="/works/">作品を見つける <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#featured-song">音楽を聴く <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero__signature">Music, visuals & little wonders.</p>
    </div>
    <figure class="hero__art">
      <picture>
        <source media="(max-width: 640px)" srcset="/images/atelier-moonlight-mobile.png" width="1122" height="1402" />
        <img src="/images/atelier-moonlight.png" alt="月明かりが差す音楽室で、青い髪のKanonが創作する水彩イラスト" width="1536" height="1024" fetchpriority="high" decoding="async" />
      </picture>
      <figcaption><span aria-hidden="true">☾</span> Welcome to my moonlit atelier <span aria-hidden="true">✧</span></figcaption>
    </figure>
  </section>

  <section class="featured-song" id="featured-song" aria-labelledby="featured-song-title">
    <a class="featured-song__cover" href="/works/ryuseimachi/" aria-label="流星待ちの作品詳細">
      <img src={song.data.cover} alt={song.data.coverAlt} width={song.data.coverWidth} height={song.data.coverHeight} loading="lazy" decoding="async" />
    </a>
    <div class="featured-song__copy">
      <p class="eyebrow">Featured music <span aria-hidden="true">/</span> 今夜の一曲</p>
      <h2 id="featured-song-title">流星待ち</h2>
      <p>{song.data.description}</p>
      <p class="featured-song__genre">{song.data.genre}</p>
    </div>
    <div class="featured-song__actions">
      <a class="button" href={song.data.externalUrl} rel="noopener noreferrer" data-featured-listen><span aria-hidden="true">▷</span> Sunoで聴く <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/journal/ryuseimachi/">歌詞の物語を読む <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-section moods" aria-labelledby="moods-title">
    <header class="section-heading"><div><p class="eyebrow">Find your mood</p><h2 id="moods-title">今日は、どんな気分？</h2></div><a class="text-link" href="/works/?category=music">すべての音楽 <span aria-hidden="true">→</span></a></header>
    <div class="mood-grid">
      {moods.map((mood) => <a class:list={['mood-card', `mood-card--${mood.id}`]} href={`/works/?style=${mood.id}`} data-mood-link={mood.id}>
        <span class="mood-card__symbol" aria-hidden="true">{mood.symbol}</span>
        <div><h3>{mood.title}</h3><p>{mood.note}<br /><span>{mood.detail}</span></p></div>
        <span class="mood-card__arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>

  <section class="home-section selected-works" aria-labelledby="selected-works-title">
    <header class="section-heading"><div><p class="eyebrow">Selected visuals</p><h2 id="selected-works-title">夢のかけらを、一枚に。</h2></div><a class="text-link" href="/works/?category=visual">すべてのビジュアル <span aria-hidden="true">→</span></a></header>
    <WorkGrid works={visualWorks} variant="featured" />
  </section>

  <GameSpotlight />

  <section class="home-section journal" aria-labelledby="journal-title">
    <header class="section-heading"><div><p class="eyebrow">From the notebook</p><h2 id="journal-title">Journal <span class="heading-note">制作の余白に。</span></h2></div><a class="text-link" href="/journal/">ノートをすべて読む <span aria-hidden="true">→</span></a></header>
    <div class="journal__entries">{journal.map((entry) => <JournalRow title={entry.data.title} summary={entry.data.summary} category={entry.data.category} publishedAt={entry.data.publishedAt} href={`/journal/${entry.id}/`} headingLevel="h3" />)}</div>
  </section>

  <section class="atelier-about" aria-labelledby="atelier-about-title">
    <img class="atelier-about__portrait" src="/images/kanon-avatar.jpg" alt="Kanon Studioの青い髪のキャラクターポートレート" width="682" height="1024" loading="lazy" decoding="async" />
    <div class="atelier-about__copy"><p class="eyebrow">Hello, I'm Kanon</p><h2 id="atelier-about-title">好きな世界を、少しずつ。</h2><p>音楽、ビジュアル、映像。<br />心に浮かんだ景色を、作品にしています。</p><a class="text-link" href="/about/">Kanon Studioについて <span aria-hidden="true">→</span></a></div>
    <ServiceHub headingId="home-service-hub-title" heading="Kanon Studio elsewhere" />
  </section>
</BaseLayout>

<style>
  .hero { display: grid; align-items: center; grid-template-columns: .78fr 1.22fr; gap: 42px; padding-block: 4px 34px; }
  .hero__copy { padding-left: 8px; }
  .eyebrow { color: var(--color-primary); font-size: 11px; font-weight: 500; letter-spacing: .09em; margin: 0 0 12px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 8px; }
  .hero .eyebrow span { font-size: 20px; }
  h1 { font-family: var(--font-display); font-size: clamp(2rem, 3.7vw, 2.875rem); font-weight: 500; line-height: var(--type-display-line-height); letter-spacing: .04em; margin: 14px 0 18px; }
  .hero__description { color: var(--color-muted); font-size: 14px; line-height: 1.9; margin: 0 0 22px; }
  .hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; }
  .hero__signature { color: var(--color-muted); font-size: 11px; letter-spacing: .04em; margin: 22px 0 0; }
  .hero__art { margin: 0; overflow: hidden; }
  .hero__art picture { display: block; background: var(--color-lavender); padding: 6px; border-radius: 60px 6px 6px 6px; }
  .hero__art img { width: 100%; height: auto; aspect-ratio: 1.65; object-fit: cover; object-position: 68% 50%; border-radius: 54px 3px 3px 3px; }
  .hero__art figcaption { display: flex; align-items: center; justify-content: space-between; padding: 8px 3px 0; color: var(--color-muted); font-size: 10px; letter-spacing: .045em; }
  .hero__art figcaption span { color: var(--color-primary); font-size: 15px; }
  .featured-song { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; align-items: center; gap: 24px; border-block: 1px solid var(--color-border); padding: 22px 0; }
  .featured-song__cover { display: block; border-radius: 5px; overflow: hidden; }
  .featured-song__cover img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: center 30%; }
  .featured-song .eyebrow { margin-bottom: 7px; }
  .featured-song h2 { font-size: 24px; }
  .featured-song__copy > p:not(.eyebrow) { font-size: 14px; color: var(--color-muted); margin: 7px 0 0; }
  .featured-song__copy .featured-song__genre { font-size: 11px; letter-spacing: .025em; }
  .featured-song__actions { display: grid; gap: 4px; justify-items: center; }
  .home-section { padding-top: 52px; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 22px; }
  .section-heading .eyebrow { margin-bottom: 7px; }
  h2 { font-family: var(--font-display); font-size: clamp(1.375rem, 2vw, 1.625rem); font-weight: 500; letter-spacing: .015em; line-height: 1.5; margin: 0; }
  .heading-note { color: var(--color-muted); font-family: var(--font-body); font-size: 12px; font-weight: 400; margin-left: 15px; }
  .mood-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .mood-card { display: flex; position: relative; align-items: start; gap: 16px; padding: 20px 0 16px; border-top: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; transition: border-color 180ms ease-out; }
  .mood-card:hover { border-color: var(--color-primary); }
  .mood-card__symbol { display: grid; place-items: center; flex: none; color: var(--color-primary); width: 42px; height: 42px; font-size: 26px; border-radius: 50%; background: var(--color-lavender); }
  .mood-card--dark .mood-card__symbol { background: #E8E6EE; }
  .mood-card--pop .mood-card__symbol { background: var(--color-blue-surface); }
  .mood-card h3 { font-family: var(--font-display); font-size: 22px; font-weight: 500; margin: 0 0 7px; }
  .mood-card p { color: var(--color-muted); font-size: 14px; line-height: 1.85; margin: 0; }
  .mood-card__arrow { position: absolute; right: 1px; top: 20px; color: var(--color-primary); font-size: 14px; }
  .journal__entries { border-block: 1px solid var(--color-border); }
  .atelier-about { display: grid; grid-template-columns: 90px 1fr auto; align-items: center; gap: 28px; margin-top: 52px; padding-block: 30px 4px; border-top: 1px solid var(--color-border); }
  .atelier-about__portrait { width: 90px; height: 90px; object-fit: cover; object-position: center top; border-radius: 50%; }
  .atelier-about .eyebrow { margin-bottom: 7px; }
  .atelier-about h2 { font-size: 22px; }
  .atelier-about__copy { min-width: 0; }
  .atelier-about__copy > p:not(.eyebrow) { font-size: 14px; color: var(--color-muted); line-height: 1.85; margin: 10px 0 0; }
  @media (max-width: 1023px) {
    .hero { gap: 24px; }
    .hero__copy { padding-left: 0; }
    .hero__art img { aspect-ratio: 1.3; }
    .hero__signature { display: none; }
    .featured-song { grid-template-columns: 88px minmax(0, 1fr); gap: 15px 22px; }
    .featured-song__actions { grid-column: 2; display: flex; flex-wrap: wrap; gap: 16px; }
    .featured-song__cover { grid-row: 1 / span 2; }
    .mood-grid { gap: 20px; }
    .mood-card { gap: 10px; }
    .mood-card__symbol { width: 34px; height: 34px; font-size: 23px; }
    .mood-card p { font-size: 14px; }
    .atelier-about { grid-template-columns: 80px 1fr; }
    .atelier-about :global(.service-hub) { grid-column: 2; }
  }
  @media (max-width: 767px) {
    .hero { grid-template-columns: 1fr; gap: 20px; padding-block: 0 25px; }
    .hero__copy { padding: 0; }
    .hero .eyebrow { font-size: 10px; margin-bottom: 8px; }
    h1 { font-size: clamp(1.75rem, 8.5vw, 2.125rem); margin: 9px 0 13px; }
    .hero__description { margin-bottom: 16px; }
    .hero__actions { gap: 16px; }
    .hero__art picture { padding: 4px; border-radius: 32px 4px 4px 4px; }
    .hero__art img { aspect-ratio: 1.65; border-radius: 28px 2px 2px 2px; }
    .hero__art figcaption { font-size: 9px; padding-top: 6px; }
    .featured-song { gap: 13px; padding-block: 18px; grid-template-columns: 70px minmax(0, 1fr); }
    .featured-song__cover { grid-row: 1; }
    .featured-song__actions { grid-column: 1 / -1; justify-content: space-between; gap: 6px; }
    .featured-song h2 { font-size: 22px; }
    .featured-song .eyebrow { font-size: 10px; letter-spacing: .02em; }
    .featured-song__copy .featured-song__genre { display: none; }
    .home-section { padding-top: 36px; }
    .section-heading { flex-wrap: wrap; gap: 4px; margin-bottom: 15px; }
    .section-heading > .text-link { margin-left: auto; min-height: 44px; }
    .mood-grid { grid-template-columns: 1fr; gap: 0; }
    .mood-card { align-items: center; padding-block: 14px; gap: 14px; }
    .mood-card h3 { font-size: 20px; margin-bottom: 3px; }
    .mood-card p { font-size: 14px; }
    .mood-card p br, .mood-card p span { display: none; }
    .mood-card__symbol { width: 36px; height: 36px; font-size: 24px; }
    .mood-card__arrow { top: 18px; }
    .heading-note { margin-left: 8px; }
    .atelier-about { margin-top: 36px; padding-top: 24px; gap: 17px; grid-template-columns: 56px minmax(0, 1fr); }
    .atelier-about__portrait { width: 56px; height: 56px; align-self: start; margin-top: 3px; }
    .atelier-about h2 { font-size: 20px; }
    .atelier-about__copy .eyebrow { margin: 0 0 7px; font-size: 10px; }
    .atelier-about__copy > a { justify-content: start; text-align: left; }
    .atelier-about :global(.service-hub) { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .hero__art img { aspect-ratio: 1.5; object-position: 50% 54%; }
  }
</style>
