---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackPlayer from '../components/TrackPlayer.astro';
import MusicPreview from '../components/MusicPreview.astro';
import XActions from '../components/XActions.astro';
import LikeButton from '../components/LikeButton.astro';
import { getListeningCatalog } from '../lib/listening';
const tracks = getListeningCatalog(await getCollection('works'));
const playableCount = tracks.filter(track => track.previewAvailable !== false).length;
---
<BaseLayout title="Music — Kanon Studio" description="気になる音を、30秒から。Kanon Studioの楽曲をその場で試聴できるリスニングルーム。" theme="night">
  <section class="music-room" aria-labelledby="music-title">
    <header class="room-intro">
      <a class="text-link" href="/#music-title">トップページの音楽へ戻る <span aria-hidden="true">←</span></a>
      <p class="eyebrow">THE LISTENING ROOM / {tracks.length} TRACKS</p>
      <h1 id="music-title">気になる音を、<br />30秒から。</h1>
      <p class="intro-copy">タイトルで選んでも、気分で選んでも。<br />ひとつ再生して、次の好きな音へ。</p>
      <p class="intro-copy">{playableCount}曲を30秒試聴できます。音源を準備中の{tracks.length - playableCount}曲は、一覧の後ろにまとめています。</p>
      <a class="text-link" href="#tracks">曲を聴く <span aria-hidden="true">↓</span></a>
      <details class="track-index">
        <summary id="track-index">曲名から探す <span>全{tracks.length}曲</span></summary>
        <nav aria-label="曲名から試聴欄へ移動">
          <ol>
            {tracks.map((track) => <li><a href={`#${track.id}`}>
              <span>{track.title}</span>
              <small>{track.previewAvailable === false ? '音源は準備中' : '30秒試聴'}</small>
            </a></li>)}
          </ol>
        </nav>
      </details>
    </header>
    <div class="collection-heading"><h2 id="tracks" tabindex="-1">楽曲</h2><p>試聴できる曲を先に、各グループ内は新しい日付順 / 制作日・未確認の場合は公開日</p></div>
    <ol class="track-list">
      {tracks.map((track, index) => <li class="room-track" id={track.id} tabindex="-1" aria-labelledby={`${track.id}-title`} data-track-id={track.id} data-now-playing={track.id} data-preview-available={track.previewAvailable === false ? "false" : "true"}>
        <div class="track-art" aria-hidden="true">
          {track.cover ? <img src={track.cover} alt="" width="320" height="320" loading="lazy" decoding="async" /> : <svg class="record-art" viewBox="0 0 220 220" width="220" height="220" focusable="false"><rect width="220" height="220" fill="#292440" /><circle cx="110" cy="110" r="92" fill="#11182b" /><g fill="none" stroke="#373c54" stroke-width="2"><circle cx="110" cy="110" r="82" /><circle cx="110" cy="110" r="72" /><circle cx="110" cy="110" r="62" /></g><circle cx="110" cy="110" r="42" fill="#c4b7e6" /><circle cx="110" cy="110" r="9" fill="#11182b" /></svg>}
          <span class="track-number">{String(index + 1).padStart(2, '0')}</span>
        </div>
        {track.previewAvailable !== false && <button class="jacket-play" type="button" data-dock-play={track.id} data-dock-title={track.title} data-play-state="paused" aria-label={`${track.title}を30秒試聴する`}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="play-icon" d="M8 5v14l11-7z" /><path class="pause-icon" d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg></button>}
        <div class="track-copy">
          <p class="track-date">{track.createdAt ? <>制作日 <time datetime={track.createdAt}>{track.createdAt.replaceAll('-', '.')}</time></> : track.publishedAt ? <>公開日 <time datetime={track.publishedAt}>{track.publishedAt.replaceAll('-', '.')}</time><span> · 制作日未確認</span></> : '制作日未確認'}</p>
          <p class="track-headline">{track.headline}</p>
          <h3 id={`${track.id}-title`}>{track.title}</h3>
          {track.edition && <p class="edition">{track.edition}</p>}
          {track.tags.length > 0 && <ul class="tags" aria-label="音の特徴">{track.tags.map((tag) => <li>{tag}</li>)}</ul>}
        </div>
        <div class="room-track__player">
          {track.previewAvailable === false ? <MusicPreview title={track.title} sunoUrl={track.sunoUrl} /> : <TrackPlayer trackId={track.id} title={track.title} sunoUrl={track.sunoUrl} />}
          {track.detailUrl && <a class="text-link" href={track.detailUrl} aria-label={`${track.title}の紹介を見る`}>曲の紹介を見る <span aria-hidden="true">↗</span></a>}
          <XActions title={track.title} path={track.detailUrl ?? `/music/#${track.id}`} compact />
          <LikeButton workId={track.detailUrl ? track.detailUrl.split('/')[2] : track.id} title={track.title} />
          <a class="track-index-return" href="#track-index">曲名一覧へ戻る <span aria-hidden="true">↑</span></a>
        </div>
      </li>)}
    </ol>
    <footer class="room-footer"><p>もう少し、音の世界へ。</p><a class="text-link" href="/works/?category=music">すべての作品を見る <span aria-hidden="true">↗</span></a></footer>
    <XActions title="Kanon Studioの音楽" />
  </section>
</BaseLayout>
<script>
  import { initMusicIndex } from '../lib/music-index';
  document.addEventListener('astro:page-load', () => initMusicIndex());
</script>
<style>
  .music-room { width: 100%; min-width: 0; max-width: 960px; margin-inline: auto; }
  .room-intro { padding: clamp(28px, 6vw, 80px) 0 64px; }
  .eyebrow { color: var(--color-primary); letter-spacing: .16em; font-size: 11px; }
  h1 { margin: 28px 0; font-size: clamp(32px, 6vw, 62px); font-weight: 500; line-height: 1.6; letter-spacing: .06em; }
  .intro-copy { color: var(--color-muted); font-size: 14px; line-height: 2.2; }
  .track-index { margin-top: 24px; border: 1px solid var(--color-control-border); border-radius: 6px; }
  .track-index summary { padding: 14px 16px; min-height: 44px; cursor: pointer; color: var(--color-primary); scroll-margin-top: 110px; }
  .track-index summary span { margin-left: 8px; font-size: 12px; color: var(--color-muted); }
  .track-index ol { display: grid; grid-template-columns: minmax(0, 1fr); list-style: none; margin: 0; padding: 0 16px 12px; }
  .track-index li { min-width: 0; }
  .track-index a { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; min-height: 44px; padding: 10px 0; border-top: 1px solid var(--color-border); color: var(--color-primary); font-size: 13px; line-height: 1.8; text-decoration: none; }
  .track-index a > span { overflow-wrap: anywhere; }
  .track-index small { color: var(--color-muted); font-size: 11px; }
  .track-index a:hover > span { text-decoration: underline; text-underline-offset: 4px; }
  .track-index-return { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; margin-top: 8px; padding: 8px 0; font-size: 12px; color: var(--color-muted); text-underline-offset: 4px; }
  .collection-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-bottom: 1px solid var(--color-border); padding-bottom: 20px; }
  .collection-heading h2 { font-size: 21px; }
  .collection-heading p, .track-date { font-size: 11px; color: var(--color-muted); }
  #tracks { scroll-margin-top: 110px; }
  .room-track { scroll-margin-top: 110px; }
  .track-list { list-style: none; padding: 0; margin: 0; }
  .room-track { display: grid; grid-template-columns: 320px minmax(0, 1fr); grid-template-areas: "art copy" "art player"; column-gap: 40px; row-gap: 0; padding: 40px 0; border-bottom: 1px solid var(--color-border); }
  .track-art { grid-area: art; width: 100%; aspect-ratio: 1 / 1; min-width: 0; position: relative; align-self: start; overflow: hidden; border-radius: 6px; }
  .track-copy { grid-area: copy; min-width: 0; }
  .room-track__player { grid-area: player; min-width: 0; }
  .room-track__player :global(audio) { min-width: 0; max-width: 100%; }
  .track-art img, .record-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .track-number { position: absolute; left: 12px; bottom: 12px; background: #090d1be6; padding: 4px 9px; color: #f4f3fc; font-size: 11px; }
  .track-date { margin: 0 0 16px; }
  .track-headline { color: var(--color-primary); font-size: 13px; line-height: 1.9; margin: 0 0 8px; }
  h3 { font-size: clamp(20px, 3vw, 27px); line-height: 1.7; margin: 0; font-weight: 500; overflow-wrap: anywhere; }
  .edition { margin: 6px 0 0; font-size: 12px; color: var(--color-muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 16px 0 24px; }
  .tags li { font-size: 11px; padding: 4px 10px; border: 1px solid var(--color-border); border-radius: 30px; color: var(--color-muted); }
  .room-footer { padding: 48px 0 16px; text-align: center; }
  .room-footer p { font-size: 20px; }
  @media(max-width: 767px) {
    .room-track { grid-template-columns: minmax(0, 1fr); grid-template-areas: "art" "copy" "player"; column-gap: 0; row-gap: 20px; padding-block: 30px; }
    .track-art { max-width: 480px; justify-self: center; }
    .track-number { left: 12px; bottom: 4px; font-size: 9px; padding: 2px 6px; }
    .track-date { font-size: 10px; margin-bottom: 10px; }
    .track-date span { display: block; }
    .track-headline { font-size: 12px; }
    .tags { margin-bottom: 0; }
    .room-intro { padding-bottom: 40px; }
  }

  /* —— 2026-11 renewal: jacket grid. Square jackets stay prominent; the page is a third as long. —— */
  .music-room { max-width: 1200px; }
  .room-intro { max-width: 760px; }
  .track-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 24px; padding-top: 32px; }
  .room-track { position: relative; grid-template-columns: minmax(0, 1fr); grid-template-areas: "art" "copy" "player"; grid-template-rows: auto auto 1fr; row-gap: 16px; padding: 14px 14px 10px; border: 1px solid var(--color-border); border-radius: 14px; background: linear-gradient(180deg, #121930, #0c1122); transition: border-color 240ms ease, box-shadow 240ms ease; }
  .room-track:hover { border-color: #c4b7e666; }
  .room-track[data-now-playing-active] { border-color: #c4b7e6; box-shadow: 0 0 0 1px #c4b7e6, 0 18px 50px -18px #8f7bd699; }
  .room-track[data-preview-available="false"] { background: transparent; }
  .track-art { border-radius: 8px; }
  .track-art img { transition: transform 480ms ease; }
  .room-track:hover .track-art img { transform: scale(1.03); }
  .jacket-play { grid-area: art; align-self: end; justify-self: end; margin: 0 12px 12px 0; z-index: 1; display: none; place-items: center; width: 52px; height: 52px; border: 0; border-radius: 50%; background: #c4b7e6f2; color: #101323; cursor: pointer; box-shadow: 0 8px 24px #05081299; transition: transform 180ms ease, background 180ms ease; }
  :global(html.dock-ready) .jacket-play { display: grid; }
  .jacket-play:hover { transform: scale(1.08); background: #ded4f5; }
  .jacket-play svg { width: 24px; height: 24px; fill: currentColor; }
  .pause-icon { display: none; }
  [data-play-state="playing"] .play-icon { display: none; }
  [data-play-state="playing"] .pause-icon { display: block; }
  .track-date { margin-bottom: 8px; }
  h3 { font-size: 19px; line-height: 1.6; }
  .tags { margin: 12px 0 0; gap: 6px; }
  .room-track__player { display: flex; flex-direction: column; align-items: start; justify-content: end; }
  .room-track__player > :global(*) { max-width: 100%; }
  .room-track__player :global(.track-player) { width: 100%; }
  .room-track__player :global(.track-player__toggle) { border-radius: 999px; min-height: 48px; margin-bottom: 4px; }
  :global(html.dock-ready) .room-track__player :global(.track-player__toggle) { display: none; }
  .room-track__player :global(.track-player__suno) { margin-top: 6px; border: 0; padding-inline: 2px; }
  .room-track__player :global(.music-preview) { width: 100%; padding: 14px; background: transparent; }
  .room-track__player :global(.work-like) { margin-block: 6px 0; }
  .track-index-return { margin-top: 0; }
  @media (max-width: 1023px) { .track-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) {
    .track-list { gap: 14px 12px; padding-top: 20px; }
    .room-track { padding: 10px 10px 6px; row-gap: 10px; border-radius: 12px; }
    .track-art { max-width: none; }
    .jacket-play { width: 46px; height: 46px; margin: 0 8px 8px 0; }
    h3 { font-size: 15px; }
    .track-headline, .tags, .track-index-return { display: none; }
    .room-track__player :global(.x-actions) { display: none; }
    .room-track__player :global(.track-player__suno), .room-track__player :global(.text-link) { font-size: 11px; min-height: 44px; }
    .room-track__player :global(.music-preview__note) { display: none; }
    .room-track__player :global(.music-preview__pending) { font-size: 14px; }
  }
  @media (max-width: 359px) { .track-list { grid-template-columns: minmax(0, 1fr); } }
</style>
