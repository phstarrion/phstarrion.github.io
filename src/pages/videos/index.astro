---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NagiShowcase from '../../components/NagiShowcase.astro';
import { nagi } from '../../lib/projects';
---
<BaseLayout title={`Videos — ${nagi.name} | Kanon Studio`} description={`${nagi.host}が案内する解説動画シリーズ「${nagi.name}」。${nagi.lead}`}>
  <section class="videos" aria-labelledby="videos-title">
    <a class="text-link" href="/">← Kanon Studio</a>
    <header class="videos__intro">
      <p class="eyebrow">Kanon Studio / Videos</p>
      <h1 id="videos-title">動画を見る</h1>
      <p>音楽とイラストのとなりで育てている、もうひとつのシリーズ。<br />「なぜ、そこにあるのか」を、地図を広げて考えます。</p>
    </header>
    <NagiShowcase variant="page" />
  </section>
</BaseLayout>
<style>
  .videos { max-width: 1120px; margin-inline: auto; padding-block: 8px 40px; }
  .videos__intro { padding: clamp(24px, 5vw, 56px) 0 clamp(32px, 5vw, 56px); }
  .eyebrow { margin: 0 0 12px; font-size: 10px; letter-spacing: .18em; color: var(--color-primary); }
  h1 { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(30px, 5vw, 46px); letter-spacing: .04em; line-height: 1.45; }
  .videos__intro > p:last-child { margin: 16px 0 0; color: var(--color-muted); font-size: 14px; line-height: 1.95; }
</style>
