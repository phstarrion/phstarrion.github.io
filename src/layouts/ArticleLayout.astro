---
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
  kicker?: string;
  lead?: string;
  byline?: string;
  cover?: string;
  coverAlt?: string;
  coverWidth?: number;
  coverHeight?: number;
  coverCaption?: string;
  sections?: { id: string; text: string }[];
}

const {
  title,
  description,
  category,
  publishedAt,
  kicker,
  lead,
  byline = 'Kanon Studio',
  cover,
  coverAlt,
  coverWidth,
  coverHeight,
  coverCaption,
  sections = [],
} = Astro.props;

const isoDate = publishedAt.toISOString().slice(0, 10);
const displayDate = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(publishedAt);
const hasCover = Boolean(cover && coverAlt && coverWidth && coverHeight);
---

<BaseLayout
  title={`${title} — Journal — Kanon Studio`}
  description={description}
  image={cover}
  imageAlt={coverAlt}
  type="article"
  publishedTime={publishedAt}
>
  <article class="article">
    <a class="article__back" href="/journal/">← Journal</a>

    <header class="article__masthead">
      <p class="article__kicker">{kicker ? `${category} / ${kicker}` : category}</p>
      <h1>{title}</h1>

      <div class="article__opening">
        {hasCover && (
          <figure class="article__figure">
            <img
              src={cover}
              alt={coverAlt}
              width={coverWidth}
              height={coverHeight}
              decoding="async"
              fetchpriority="high"
            />
            {coverCaption && <figcaption>{coverCaption}</figcaption>}
          </figure>
        )}

        <div class="article__intro">
          {lead && <p class="article__lead">{lead}</p>}

          {sections.length > 0 && (
            <nav class="article__index" aria-labelledby="article-index-title">
              <p id="article-index-title">Contents</p>
              <ol>
                {sections.map((section) => (
                  <li><a href={`#${section.id}`}>{section.text}</a></li>
                ))}
              </ol>
            </nav>
          )}

          <dl class="article__credits">
            <div>
              <dt>Text</dt>
              <dd>{byline}</dd>
            </div>
            <div>
              <dt>Date</dt>
              <dd><time datetime={isoDate}>{displayDate}</time></dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <div class="article__prose prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    display: grid;
    gap: var(--space-xl);
    max-width: 960px;
  }

  .article__back {
    justify-self: start;
    min-height: 44px;
    padding-block: 10px;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .article__masthead {
    border-top: 2px solid var(--color-ink);
    display: grid;
    gap: var(--space-lg);
    padding-top: var(--space-md);
  }

  .article__kicker {
    color: var(--color-kanon-blue-hover);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    line-height: var(--type-label-line-height);
    margin: 0;
    text-transform: uppercase;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.5vw, var(--type-headline-lg-size));
    font-weight: var(--type-headline-lg-weight);
    letter-spacing: var(--type-headline-lg-letter-spacing);
    line-height: 1.35;
    margin: 0;
    max-width: 20em;
  }

  .article__opening {
    display: grid;
    gap: var(--space-lg);
  }

  .article__figure {
    margin: 0;
  }

  .article__figure img {
    background: var(--color-surface);
    display: block;
    height: auto;
    width: 100%;
  }

  .article__figure figcaption {
    border-left: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--type-body-sm-size);
    line-height: var(--type-body-sm-line-height);
    margin-top: var(--space-md);
    padding-left: var(--space-sm);
  }

  .article__intro {
    display: grid;
    gap: var(--space-lg);
  }

  .article__lead {
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.85;
    margin: 0;
  }

  .article__index > p {
    color: var(--color-muted);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    line-height: var(--type-label-line-height);
    margin: 0 0 var(--space-sm);
    text-transform: uppercase;
  }

  .article__index ol {
    counter-reset: article-index;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article__index li {
    border-top: 1px solid var(--color-border);
  }

  .article__index a {
    align-items: baseline;
    color: var(--color-ink);
    display: grid;
    font-size: var(--type-body-sm-size);
    gap: var(--space-md);
    grid-template-columns: 1.75em minmax(0, 1fr);
    line-height: var(--type-body-sm-line-height);
    min-height: 44px;
    padding-block: var(--space-sm);
    text-decoration: none;
  }

  .article__index a::before {
    color: var(--color-coral-hover);
    content: counter(article-index, decimal-leading-zero);
    counter-increment: article-index;
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
  }

  .article__index a:hover,
  .article__index a:focus-visible {
    color: var(--color-kanon-blue-hover);
  }

  .article__credits {
    align-self: end;
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding-top: var(--space-md);
  }

  .article__credits > div {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 72px minmax(0, 1fr);
  }

  .article__credits dt {
    color: var(--color-muted);
    font-size: var(--type-label-size);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-letter-spacing);
    text-transform: uppercase;
  }

  .article__credits dd {
    font-size: var(--type-body-sm-size);
    margin: 0;
  }

  .article__prose {
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .article__opening {
      align-items: start;
      column-gap: var(--space-xl);
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }

    .article__figure {
      grid-column: 1;
      grid-row: 1;
    }

    .article__intro {
      align-content: space-between;
      grid-column: 2;
      grid-row: 1;
      min-height: 100%;
    }

    .article__lead {
      font-weight: 400;
    }
  }
</style>
