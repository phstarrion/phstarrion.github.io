---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

import { xHandle } from '../lib/services';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  theme?: 'default' | 'night';
}

const { title, description, image, imageAlt, type = 'website', publishedTime, theme = 'default' } = Astro.props;
const site = Astro.site ?? new URL('https://phstarrion.github.io/');
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, site);
const brandImage = '/images/social/kanon-studio-v1.jpg';
const socialImage = image ?? brandImage;
const socialImageAlt = imageAlt ?? (socialImage === brandImage ? '月明かりの音楽室と、白銀色の髪・猫耳・丸眼鏡の看板キャラクター。Kanon Studioと作者名の共有用カード' : undefined);
const imageUrl = new URL(socialImage, site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={theme === 'night' ? '#090d1b' : '#FAF8F5'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600&family=Zen+Maru+Gothic:wght@500;700&display=swap"
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Kanon Studio" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    {socialImage === brandImage && <>
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>}
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {xHandle && <meta name="twitter:site" content={xHandle} />}
    {xHandle && <meta name="twitter:creator" content={xHandle} />}
    <title>{title}</title>
  </head>
  <body class:list={{ 'theme-night': theme === 'night' }}>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<script>
  import { initLikes, recordVisit } from '../lib/engagement';
  initLikes();
  void recordVisit();
</script>
